import MathFin

/-!
# Connector: the dealer's quote after a history of trades

`MathFin.Execution.condExp_payoff_eq_quote` identifies the ask and the bid of one trade with the
conditional expectation of the value given the trade direction. The Glosten–Milgrom dealer's
quote after `n` trades is the integral against the measure conditioned on the observed history.
-/

open MathFin MeasureTheory ProbabilityTheory

/-- **The quote after a history of trades is the conditional expectation.** If the public
information after `n` trades is generated by the first `n` trade-direction events `B k`, then
`μ[V | 𝓖 n]` is, almost everywhere, the integral of the value against `μ` conditioned on the
event that the history is the one observed. -/
theorem MathFinFrontier.condExp_payoff_eq_quote_history {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (μ : Measure Ω) [IsProbabilityMeasure μ] (𝓖 : Filtration ℕ mΩ) {H : Set Ω}
    (B : ℕ → Set Ω) (hB : ∀ n, MeasurableSet (B n))
    (h𝓖 : ∀ n, 𝓖 n = MeasurableSpace.generateFrom {s | ∃ k < n, s = B k}) (VL VH : ℝ) (n : ℕ) :
    μ[Execution.payoff H VL VH | 𝓖 n] =ᵐ[μ] fun ω ↦
      ∫ ω', Execution.payoff H VL VH ω' ∂μ[|{ω' | ∀ k < n, ω' ∈ B k ↔ ω ∈ B k}] := by
  sorry
