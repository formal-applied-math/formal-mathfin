/-!
# Lundberg's inequality for a random-walk surplus

The surplus of an insurer after `n` periods is `Uₙ = u + ∑_{k<n} Yₖ`, where `u` is the initial
capital and the increments `Yₖ` (premium minus claims of one period) are independent and
identically distributed. Ruin is the event `{∃ n, Uₙ < 0}`. If `R > 0` is an *adjustment
coefficient*, `𝔼[e^{−R Y₀}] = 1`, then `n ↦ e^{−R Uₙ}` is a martingale (a product of independent
mean-one factors), and Doob's maximal inequality bounds the probability that it reaches `1` by
its initial value: `ℙ(ruin) ≤ e^{−R u}`.

The martingale is `martingale_exp_sub_of_indep_increments` for the exponent `−R Uₙ` with
`ψ = 0`, in the filtration `incrementFiltration` generated by the increments seen so far. Ruin
by time `n` is contained in `{max_{k ≤ n} e^{−R U_k} ≥ 1}`, whose probability is at most
`𝔼[e^{−R Uₙ}] = e^{−R u}` by `maximal_ineq`; ruin at some time is the increasing union of these
events.

This is the discrete-time statement. It does not use `𝔼 Y₀ > 0`, which is what makes an
adjustment coefficient exist, and it does not construct one: the root of
`𝔼[e^{−R Y₀}] = 1` is a hypothesis. The Cramér–Lundberg model of continuous-time ruin is reduced
to this walk in `Insurance/CramerLundberg.lean`.

## Main definitions

* `MathFin.surplus u Y n`: the surplus `u + ∑_{k<n} Yₖ` after `n` increments.
* `MathFin.incrementFiltration Y`: the filtration `𝓕ₙ = σ(Y₀, …, Y_{n−1})`.
* `MathFin.lundbergExp R u Y`: the exponential `n ↦ e^{−R Uₙ}`.

## Main results

* `MathFin.lundbergExp_martingale`: `lundbergExp R u Y` is an `incrementFiltration`-martingale
  when `𝔼[e^{−R Y₀}] = 1`.
* `MathFin.lundberg_inequality`: `ℙ(∃ n, Uₙ < 0) ≤ e^{−R u}` for `R > 0` with
  `𝔼[e^{−R Y₀}] = 1`.

## References

* [S. Asmussen and H. Albrecher, *Ruin Probabilities*][AsmussenAlbrecher2010], the Lundberg
  inequality

## Tags

ruin probability, Lundberg inequality, adjustment coefficient, random walk, exponential
martingale, Doob maximal inequality, collective risk theory, MSC 91G05, MSC 60G50, JEL G22
-/

@[expose] public section

namespace MathFin

open MeasureTheory ProbabilityTheory

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω}

/-- The **surplus** `Uₙ = u + ∑_{k<n} Yₖ` of an insurer with initial capital `u` after the first `n`
period results `Y₀, …, Y_{n−1}`. -/
def surplus (u : ℝ) (Y : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  u + ∑ k ∈ Finset.range n, Y k ω

/-- The **Lundberg exponential** `n ↦ e^{−R Uₙ}` of the surplus walk: a martingale when `R` is an
adjustment coefficient (`lundbergExp_martingale`). -/
noncomputable def lundbergExp (R u : ℝ) (Y : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  Real.exp (-R * surplus u Y n ω)

/-- The **filtration generated by the increments**: `𝓕ₙ = σ(Y₀, …, Y_{n−1})`, the history of the
first `n` period results (`𝓕₀` is trivial). -/
noncomputable def incrementFiltration (Y : ℕ → Ω → ℝ) (hY : ∀ k, Measurable (Y k)) :
    Filtration ℕ mΩ where
  seq n := ⨆ k ∈ Set.Iio n, MeasurableSpace.comap (Y k) inferInstance
  mono' _ _ h := biSup_mono fun _ hk ↦ lt_of_lt_of_le hk h
  le' _ := iSup₂_le fun k _ ↦ (hY k).comap_le

/-- A sum of increments indexed in `S ⊆ T` is measurable for the σ-algebra generated by the
increments indexed in `T`. -/
private lemma measurable_sum_iSup {Y : ℕ → Ω → ℝ} {S : Finset ℕ} {T : Set ℕ}
    (hST : ∀ k ∈ S, k ∈ T) :
    Measurable[⨆ k ∈ T, MeasurableSpace.comap (Y k) inferInstance] fun ω ↦ ∑ k ∈ S, Y k ω :=
  Finset.measurable_sum _ fun k hk ↦
    (comap_measurable (Y k)).mono
      (le_iSup₂ (f := fun k (_ : k ∈ T) ↦ MeasurableSpace.comap (Y k) inferInstance) k
        (hST k hk)) le_rfl

variable [IsProbabilityMeasure P] {Y : ℕ → Ω → ℝ} {R : ℝ}

/-- **The Lundberg exponential is a martingale at an adjustment coefficient.** If the increments
are i.i.d. and `𝔼[e^{−R Y₀}] = 1`, then `n ↦ e^{−R Uₙ}` is a martingale for the filtration
generated by the increments. The increment `−R(Uₜ − Uₛ) = −R ∑_{s ≤ k < t} Yₖ` is independent of
`σ(Y_k, k < s)` with exponential mean `(𝔼 e^{−R Y₀})^{t−s} = 1`
(`martingale_exp_sub_of_indep_increments`). -/
theorem lundbergExp_martingale (u : ℝ) (hY : ∀ k, Measurable (Y k)) (hindep : iIndepFun Y P)
    (hident : ∀ k, IdentDistrib (Y k) (Y 0) P P) (hadj : mgf (Y 0) P (-R) = 1) :
    Martingale (lundbergExp R u Y) (incrementFiltration Y hY) P := by
  have hadj' : ∫ ω, Real.exp (-R * Y 0 ω) ∂P = 1 := hadj
  have hdiff (s t : ℕ) (hst : s ≤ t) (ω : Ω) : -R * surplus u Y t ω - -R * surplus u Y s ω
      = -R * ∑ k ∈ Finset.Ico s t, Y k ω := by
    rw [Finset.sum_Ico_eq_sub _ hst]
    simp only [surplus]
    ring
  have hint0 : Integrable (fun ω ↦ Real.exp (-R * Y 0 ω)) P :=
    Integrable.of_integral_ne_zero (by rw [hadj']; exact one_ne_zero)
  have hadapted : StronglyAdapted (incrementFiltration Y hY) fun n ω ↦ -R * surplus u Y n ω :=
    fun n ↦ (((measurable_sum_iSup (Y := Y) (S := Finset.range n) (T := Set.Iio n)
      fun k hk ↦ Finset.mem_range.1 hk).const_add u).const_mul (-R)).stronglyMeasurable
  have hind (s t : ℕ) (hst : s ≤ t) :
      Indep (MeasurableSpace.comap (fun ω ↦ -R * surplus u Y t ω - -R * surplus u Y s ω)
        inferInstance) (incrementFiltration Y hY s) P := by
    have h := indep_iSup_of_disjoint (m := fun k ↦ MeasurableSpace.comap (Y k) inferInstance)
      (fun k ↦ (hY k).comap_le) ((iIndepFun_iff_iIndep _ _ _).1 hindep)
      (S := Set.Ico s t) (T := Set.Iio s)
      (Set.disjoint_left.2 fun k hk hk' ↦ absurd hk.1 (not_le.2 hk'))
    refine indep_of_indep_of_le_left h ?_
    have hfun : (fun ω ↦ -R * surplus u Y t ω - -R * surplus u Y s ω)
        = fun ω ↦ -R * ∑ k ∈ Finset.Ico s t, Y k ω := funext (hdiff s t hst)
    have hD : Measurable[⨆ k ∈ Set.Ico s t, MeasurableSpace.comap (Y k) inferInstance]
        (fun ω ↦ -R * surplus u Y t ω - -R * surplus u Y s ω) := by
      rw [hfun]
      exact (measurable_sum_iSup (Y := Y) (S := Finset.Ico s t) (T := Set.Ico s t)
        fun k hk ↦ Finset.mem_Ico.1 hk).const_mul _
    exact measurable_iff_comap_le.1 hD
  have hint (t : ℕ) : Integrable (fun ω ↦ Real.exp (-R * surplus u Y t ω)) P := by
    refine ((integrable_exp_mul_sum_range_of_iid (-R) Y hindep hident hint0 t).const_mul
      (Real.exp (-R * u))).congr (ae_of_all _ fun ω ↦ ?_)
    simp only [surplus]
    rw [← Real.exp_add]
    congr 1
    ring
  have hmean (s t : ℕ) (hst : s ≤ t) :
      ∫ ω, Real.exp (-R * surplus u Y t ω - -R * surplus u Y s ω) ∂P = Real.exp ((0 : ℝ) - 0) := by
    have h : ∫ ω, Real.exp (-R * ∑ k ∈ Finset.Ico s t, Y k ω) ∂P = 1 := by
      have := mgf_finset_sum_of_iid (-R) Y hindep hident (Finset.Ico s t)
      rw [hadj, one_pow] at this
      exact this
    rw [sub_self, Real.exp_zero]
    refine (integral_congr_ae (ae_of_all _ fun ω ↦ ?_)).trans h
    simp only [hdiff s t hst]
  have hM := martingale_exp_sub_of_indep_increments (P := P) (𝓕 := incrementFiltration Y hY)
    (X := fun n ω ↦ -R * surplus u Y n ω) (ψ := fun _ ↦ 0) hadapted (fun s t hst ↦ hind s t hst)
    hint hmean
  have hfun : lundbergExp R u Y = fun t ω ↦ Real.exp (-R * surplus u Y t ω - 0) := by
    funext t ω
    simp [lundbergExp]
  rw [hfun]
  exact hM

/-- **Lundberg's inequality for the random-walk surplus.** Let the period results `Yₖ` be i.i.d.
and let `R > 0` satisfy `𝔼[e^{−R Y₀}] = 1`. Then the probability that the surplus
`Uₙ = u + ∑_{k<n} Yₖ` is ever negative is at most `e^{−R u}`. For `u < 0` the bound exceeds `1`
and is vacuous; the inequality is proved for every real `u`, with no assumption on `𝔼 Y₀`. -/
theorem lundberg_inequality (u : ℝ) (hY : ∀ k, Measurable (Y k)) (hindep : iIndepFun Y P)
    (hident : ∀ k, IdentDistrib (Y k) (Y 0) P P) (hR : 0 < R) (hadj : mgf (Y 0) P (-R) = 1) :
    P {ω | ∃ n, surplus u Y n ω < 0} ≤ ENNReal.ofReal (Real.exp (-R * u)) := by
  have hM := lundbergExp_martingale u hY hindep hident hadj
  have hnonneg : 0 ≤ lundbergExp R u Y := fun n ω ↦ (Real.exp_pos _).le
  have hcard (n : ℕ) : ∫ ω, lundbergExp R u Y n ω ∂P = Real.exp (-R * u) := by
    have h := hM.setIntegral_eq (Nat.zero_le n) MeasurableSet.univ
    simp only [Measure.restrict_univ] at h
    rw [← h]
    simp [lundbergExp, surplus, integral_const]
  have hA (n : ℕ) :
      P {ω | ∃ k ≤ n, surplus u Y k ω < 0} ≤ ENNReal.ofReal (Real.exp (-R * u)) := by
    have hmax := maximal_ineq hM.submartingale hnonneg (ε := 1) n
    simp only [NNReal.coe_one, ENNReal.coe_one, one_mul] at hmax
    refine (measure_mono ?_).trans (hmax.trans ?_)
    · rintro ω ⟨k, hk, hneg⟩
      show (1 : ℝ) ≤ _
      have hpos : 0 ≤ -R * surplus u Y k ω :=
        mul_nonneg_of_nonpos_of_nonpos (neg_nonpos.2 hR.le) hneg.le
      refine (Real.one_le_exp hpos).trans ?_
      exact Finset.le_sup' (fun j ↦ lundbergExp R u Y j ω)
        (Finset.mem_range.2 (Nat.lt_succ_of_le hk))
    · rw [← hcard n]
      exact ENNReal.ofReal_le_ofReal
        (setIntegral_le_integral (hM.integrable n) (ae_of_all _ fun ω ↦ hnonneg n ω))
  have hmono : Monotone fun n ↦ {ω | ∃ k ≤ n, surplus u Y k ω < 0} := by
    intro m n hmn ω
    rintro ⟨k, hk, hneg⟩
    exact ⟨k, hk.trans hmn, hneg⟩
  have hunion : {ω | ∃ n, surplus u Y n ω < 0} = ⋃ n, {ω | ∃ k ≤ n, surplus u Y k ω < 0} := by
    ext ω
    simp only [Set.mem_setOf_eq, Set.mem_iUnion]
    exact ⟨fun ⟨n, h⟩ ↦ ⟨n, n, le_rfl, h⟩, fun ⟨_, k, _, h⟩ ↦ ⟨k, h⟩⟩
  rw [hunion, hmono.measure_iUnion]
  exact iSup_le hA

end MathFin
