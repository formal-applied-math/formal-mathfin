/-!
# The Glosten–Milgrom quote sequence is a martingale for the dealer's measure

The one-trade theory (`GlostenMilgrom`) posits the dealer's quotes as `E[V | buy]` and
`E[V | sell]` and updates the belief `θ` that the value is high by `postBuy`/`postSell`. This
file runs the model along a sequence of trades. The value is high with prior `θ`; trader `i`
is informed with probability `p` (and then trades on the value) or else tosses a fair coin, all
independently of each other given the value; the dealer sees only the order directions. The
dealer's quote after a history is `V_L + θₙ (V_H − V_L)`, where `θₙ` iterates `postBuy`/`postSell`
over the history. The sample space is `Bool × (ℕ → Bool × Bool)` with the product measure
`Measure.infinitePi`, so there is no horizon.

The quote process is shown to be `P[V | 𝓖 n]` almost surely, `𝓖 n` the σ-algebra generated by the
first `n` order directions, and hence the dealer's measure prices the market of quotes.

## Main definitions

* `gmSeqMeasure`: the sequential Glosten–Milgrom measure on `Bool × (ℕ → Bool × Bool)`.
* `gmFiltration`: the σ-algebras generated by the first `n` order directions.
* `gmQuote`: the dealer's quote, `V_L + θₙ (V_H − V_L)` with `θₙ` iterating `postBuy`/`postSell`.

## Main results

* `condExp_comap_ae_eq_of_fibres`: for a map to a finite type, a function whose fibre masses
  match the integrals of `f` is a version of `μ[f | comap D]`.
* `gmBelief_eq`: the iterated Bayes updates are the likelihood-ratio posterior.
* `gmQuote_ae_eq_condExp`: `gmQuote n = P[V | 𝓖 n]` almost surely, for every `n`.
* `gmQuote_isPricingMeasure`: the quotes are those conditional expectations and `P` is a
  pricing measure of the market whose asset is `n ↦ P[V | 𝓖 n]`.
* `gmFiltration_one`, `gmQuote_one_ae_eq_quote`: after one order the dealer's information is
  `σ(first order is a buy)`, and the sequential quote is almost surely the posited ask on a buy
  and bid on a sell of `condExp_payoff_eq_quote`.

## Scope

Interior prior `0 < θ < 1` and informed share `0 ≤ p < 1`: at `p = 1` some histories are null
and the quote there is a junk value of `postBuy`/`postSell`. The posited quote (the Bayes
posterior) is as in `GlostenMilgrom`; its derivation from a competitive dealer's zero expected
profit is not formalized.

## References

* [L. R. Glosten and P. R. Milgrom, *Bid, ask and transaction prices in a specialist market with
  heterogeneously informed traders*][GlostenMilgrom1985]

## Tags

Glosten–Milgrom model, market maker quotes, sequential trades, Bayesian updating, martingale,
pricing measure, conditional expectation, MSC 91B26, MSC 60G42, JEL D82, JEL G14
-/

@[expose] public section

open MeasureTheory ProbabilityTheory MeasurableSpace

namespace MathFin.Execution

/-! ### A general fibre lemma for conditional expectations -/

section Fibres

variable {Ω β : Type*} [MeasurableSpace Ω] [Fintype β] [MeasurableSpace β]
  [MeasurableSingletonClass β]

/-- **Conditional expectation given a finite-valued map, from the fibres.** If the mass of each
fibre of `D` times `q b` is the integral of `f` over that fibre, then `q ∘ D` is a version of
`μ[f | comap D]`. -/
theorem condExp_comap_ae_eq_of_fibres (μ : Measure Ω) [IsFiniteMeasure μ] {D : Ω → β}
    (hD : Measurable D) {f : Ω → ℝ} (hf : Integrable f μ) (q : β → ℝ)
    (hq : ∀ b, μ.real (D ⁻¹' {b}) * q b = ∫ ω in D ⁻¹' {b}, f ω ∂μ) :
    μ[f | MeasurableSpace.comap D inferInstance] =ᵐ[μ] fun ω ↦ q (D ω) := by
  have hqD : Measurable fun ω ↦ q (D ω) := (measurable_of_finite q).comp hD
  have hint : Integrable (fun ω ↦ q (D ω)) μ :=
    .mono' (integrable_const (∑ b, |q b|)) hqD.aestronglyMeasurable
      (ae_of_all _ fun ω ↦ by
        simpa using Finset.single_le_sum (f := fun b ↦ |q b|)
          (fun b _ ↦ abs_nonneg _) (Finset.mem_univ (D ω)))
  refine (ae_eq_condExp_of_forall_setIntegral_eq hD.comap_le hf
    (fun s _ _ ↦ hint.integrableOn) (fun s hs _ ↦ ?_)
    ((measurable_of_finite q).comp (comap_measurable D)).aestronglyMeasurable).symm
  obtain ⟨t, -, rfl⟩ := hs
  classical
  have hU : D ⁻¹' t = ⋃ b ∈ Finset.univ.filter (· ∈ t), D ⁻¹' {b} := by ext; simp
  have hmeas : ∀ b ∈ Finset.univ.filter (· ∈ t), MeasurableSet (D ⁻¹' {b}) :=
    fun b _ ↦ hD (measurableSet_singleton b)
  have hdisj : Set.Pairwise (↑(Finset.univ.filter (· ∈ t)))
      (Function.onFun Disjoint fun b ↦ D ⁻¹' {b}) :=
    fun b _ b' _ hne ↦ (Set.disjoint_singleton.2 hne).preimage D
  rw [hU, integral_biUnion_finset _ hmeas hdisj (fun b _ ↦ hint.integrableOn),
    integral_biUnion_finset _ hmeas hdisj (fun b _ ↦ hf.integrableOn)]
  refine Finset.sum_congr rfl fun b _ ↦ ?_
  rw [← hq b, setIntegral_congr_fun (hD (measurableSet_singleton b))
    (fun ω hω ↦ congrArg q (Set.mem_singleton_iff.1 hω)),
    setIntegral_const, smul_eq_mul]

end Fibres

/-! ### The sequential model -/

/-- The Bernoulli law on `Bool`, `true` with probability `q` (clamped to `[0, 1]`). -/
noncomputable def gmBern (q : ℝ) : Measure Bool :=
  ProbabilityTheory.bernoulliMeasure true false (Set.projIcc (0 : ℝ) 1 zero_le_one q)

instance (q : ℝ) : IsProbabilityMeasure (gmBern q) := by unfold gmBern; infer_instance

theorem gmBern_real_true {q : ℝ} (h0 : 0 ≤ q) (h1 : q ≤ 1) : (gmBern q).real {true} = q := by
  have hq : (Set.projIcc (0 : ℝ) 1 zero_le_one q : ℝ) = q := by
    rw [Set.projIcc_of_mem _ ⟨h0, h1⟩]
  rw [gmBern, measureReal_def, ProbabilityTheory.bernoulliMeasure_apply_of_mem_of_notMem _
    (measurableSet_singleton true) (by simp) (by simp)]
  simp [hq]

theorem gmBern_real_false {q : ℝ} (h0 : 0 ≤ q) (h1 : q ≤ 1) :
    (gmBern q).real {false} = 1 - q := by
  have : ({false} : Set Bool) = {true}ᶜ := by ext b; cases b <;> simp
  rw [this, probReal_compl_eq_one_sub (measurableSet_singleton _), gmBern_real_true h0 h1]

/-- A trader is a pair: whether informed, and the coin an uninformed trader tosses. -/
abbrev GMTrader := Bool × Bool

/-- The order direction (`true` = buy) of trader `t` when the value is high iff `s`: an informed
trader trades on the value, an uninformed one follows the coin. -/
def gmDirection (s : Bool) (t : GMTrader) : Bool := if t.1 then s else t.2

/-- The law of a trader: informed with probability `p`, a fair coin independent of it. -/
noncomputable def gmTraderLaw (p : ℝ) : Measure GMTrader := (gmBern p).prod (gmBern (1 / 2))

instance (p : ℝ) : IsProbabilityMeasure (gmTraderLaw p) := by unfold gmTraderLaw; infer_instance

/-- **The sequential Glosten–Milgrom measure.** Value high with prior `θ`; independently of the
value, trader `i` is drawn from `gmTraderLaw p`, independently across `i`. -/
noncomputable def gmSeqMeasure (θ p : ℝ) : Measure (Bool × (ℕ → GMTrader)) :=
  (gmBern θ).prod (Measure.infinitePi fun _ ↦ gmTraderLaw p)

instance (θ p : ℝ) : IsProbabilityMeasure (gmSeqMeasure θ p) := by
  unfold gmSeqMeasure; infer_instance

/-- The value is high: the state coordinate is `true`. -/
def gmSeqHigh : Set (Bool × (ℕ → GMTrader)) := {ω | ω.1 = true}

theorem measurableSet_gmSeqHigh : MeasurableSet gmSeqHigh :=
  measurable_fst (measurableSet_singleton true)

/-- The likelihood of an order direction `b` when the value state is `s`: `(1 + p)/2` if the
order agrees with the value, `(1 - p)/2` otherwise. -/
noncomputable def gmLik (p : ℝ) (s b : Bool) : ℝ := if s = b then (1 + p) / 2 else (1 - p) / 2

theorem gmLik_self (p : ℝ) (s : Bool) : gmLik p s s = (1 + p) / 2 := by simp [gmLik]

theorem gmLik_ne (p : ℝ) {s b : Bool} (h : s ≠ b) : gmLik p s b = (1 - p) / 2 := by
  simp [gmLik, h]

theorem gmLik_pos {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p < 1) (s b : Bool) : 0 < gmLik p s b := by
  unfold gmLik; split_ifs <;> linarith

theorem gmTraderLaw_real {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) (s b : Bool) :
    (gmTraderLaw p).real {t | gmDirection s t = b} = gmLik p s b := by
  have rect (a c : Bool) : (gmTraderLaw p).real ({a} ×ˢ {c}) =
      (gmBern p).real {a} * (gmBern (1 / 2)).real {c} := measureReal_prod_prod _ _
  have hm (a c : Bool) : MeasurableSet (({a} : Set Bool) ×ˢ {c}) :=
    (measurableSet_singleton a).prod (measurableSet_singleton c)
  have h1 : (1 / 2 : ℝ) ≤ 1 := by norm_num
  have ff : (gmTraderLaw p).real ({false} ×ˢ {false}) = (1 - p) / 2 := by
    rw [rect, gmBern_real_false hp0 hp1, gmBern_real_false (by norm_num) h1]; ring
  have ft : (gmTraderLaw p).real ({false} ×ˢ {true}) = (1 - p) / 2 := by
    rw [rect, gmBern_real_false hp0 hp1, gmBern_real_true (by norm_num) h1]; ring
  cases s <;> cases b
  · have : {t | gmDirection false t = false} = ({false} ×ˢ {true})ᶜ := by
      ext ⟨a, c⟩; cases a <;> cases c <;> simp [gmDirection]
    rw [this, probReal_compl_eq_one_sub (hm _ _), ft]; simp [gmLik]; ring
  · have : {t | gmDirection false t = true} = {false} ×ˢ {true} := by
      ext ⟨a, c⟩; cases a <;> cases c <;> simp [gmDirection]
    rw [this, ft]; simp [gmLik]
  · have : {t | gmDirection true t = false} = {false} ×ˢ {false} := by
      ext ⟨a, c⟩; cases a <;> cases c <;> simp [gmDirection]
    rw [this, ff]; simp [gmLik]
  · have : {t | gmDirection true t = true} = ({false} ×ˢ {false})ᶜ := by
      ext ⟨a, c⟩; cases a <;> cases c <;> simp [gmDirection]
    rw [this, probReal_compl_eq_one_sub (hm _ _), ff]; simp [gmLik]; ring

/-- The first `n` order directions the dealer observes. -/
def gmHist (n : ℕ) (ω : Bool × (ℕ → GMTrader)) : Fin n → Bool :=
  fun i ↦ gmDirection ω.1 (ω.2 i)

theorem measurable_gmHist (n : ℕ) : Measurable (gmHist n) :=
  Measurable.of_eval fun i ↦ (measurable_of_finite (fun x : Bool × GMTrader ↦
    gmDirection x.1 x.2)).comp (measurable_fst.prodMk ((measurable_pi_apply (i : ℕ)).comp
      measurable_snd))

/-- **The dealer's information**: the σ-algebra generated by the first `n` order directions. -/
noncomputable def gmFiltration : Filtration ℕ (inferInstance : MeasurableSpace
    (Bool × (ℕ → GMTrader))) where
  seq n := MeasurableSpace.comap (gmHist n) inferInstance
  mono' n m h := by
    have : Measurable[MeasurableSpace.comap (gmHist m) inferInstance] (gmHist n) :=
      (Measurable.of_eval fun i ↦ measurable_pi_apply (Fin.castLE h i)).comp
        (comap_measurable (gmHist m))
    exact this.comap_le
  le' n := (measurable_gmHist n).comap_le

/-- One Bayes update of the belief that the value is high, on an order direction (`true` = buy):
`postBuy` after a buy, `postSell` after a sell. -/
noncomputable def gmStep (p θ : ℝ) (b : Bool) : ℝ := if b then postBuy θ p else postSell θ p

/-- The dealer's belief after a history: the Bayes updates `postBuy`/`postSell` iterated. -/
noncomputable def gmBelief (θ p : ℝ) (l : List Bool) : ℝ := l.foldl (gmStep p) θ

/-- **The dealer's quote** after the first `n` orders: `V_L + θₙ (V_H − V_L)`. -/
noncomputable def gmQuote (θ p VL VH : ℝ) (n : ℕ) (ω : Bool × (ℕ → GMTrader)) : ℝ :=
  VL + gmBelief θ p (List.ofFn (gmHist n ω)) * (VH - VL)

/-! ### The iterated updates are the likelihood-ratio posterior -/

theorem gmStep_eq {θ p : ℝ} (hθ0 : 0 < θ) (hθ1 : θ < 1) (hp0 : 0 ≤ p) (hp1 : p < 1)
    (b : Bool) :
    gmStep p θ b = θ * gmLik p true b / (θ * gmLik p true b + (1 - θ) * gmLik p false b) := by
  have hden : 0 < θ * gmLik p true b + (1 - θ) * gmLik p false b :=
    add_pos (mul_pos hθ0 (gmLik_pos hp0 hp1 _ _)) (mul_pos (sub_pos.2 hθ1) (gmLik_pos hp0 hp1 _ _))
  cases b
  · have hd := sell_denom_pos hθ1 hp0 hp1.le
    have e : gmStep p θ false = postSell θ p := by simp [gmStep]
    rw [gmLik_ne p (by decide : true ≠ false), gmLik_self] at hden ⊢
    rw [e, postSell, div_eq_div_iff hd.ne' hden.ne']; ring
  · have hd := buy_denom_pos hθ0 hp0 hp1.le
    have e : gmStep p θ true = postBuy θ p := by simp [gmStep]
    rw [gmLik_self, gmLik_ne p (by decide : false ≠ true)] at hden ⊢
    rw [e, postBuy, div_eq_div_iff hd.ne' hden.ne']; ring

/-- **The iterated Bayes updates are the likelihood-ratio posterior**: after a history `l` the
belief `gmBelief θ p l` is `θ ∏ lik_high / (θ ∏ lik_high + (1 - θ) ∏ lik_low)`. -/
theorem gmBelief_eq {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p < 1) :
    ∀ (l : List Bool) (θ : ℝ), 0 < θ → θ < 1 →
      gmBelief θ p l = θ * (l.map (gmLik p true)).prod /
        (θ * (l.map (gmLik p true)).prod + (1 - θ) * (l.map (gmLik p false)).prod) := by
  intro l
  induction l with
  | nil =>
    intro θ _ _
    simp only [gmBelief, List.foldl_nil, List.map_nil, List.prod_nil, mul_one]
    rw [add_sub_cancel, div_one]
  | cons b l ih =>
    intro θ h0 h1
    have ha := gmLik_pos hp0 hp1 true b
    have hc := gmLik_pos hp0 hp1 false b
    have hu : 0 < θ * gmLik p true b := mul_pos h0 ha
    have hv : 0 < (1 - θ) * gmLik p false b := mul_pos (sub_pos.2 h1) hc
    have hs := gmStep_eq h0 h1 hp0 hp1 b
    have h0' : 0 < gmStep p θ b := by rw [hs]; exact div_pos hu (add_pos hu hv)
    have h1' : gmStep p θ b < 1 := by
      rw [hs, div_lt_one (add_pos hu hv)]; linarith
    have e : gmBelief θ p (b :: l) = gmBelief (gmStep p θ b) p l := rfl
    rw [e, ih _ h0' h1', hs, List.map_cons, List.map_cons, List.prod_cons, List.prod_cons]
    -- one Bayes step: normalizing by `u + v` and then reweighting is reweighting directly
    have bayes {u v A C : ℝ} (hu : 0 < u) (hv : 0 < v) :
        u / (u + v) * A / (u / (u + v) * A + (1 - u / (u + v)) * C)
          = u * A / (u * A + v * C) := by
      have h1 : u + v ≠ 0 := (add_pos hu hv).ne'
      have e : 1 - u / (u + v) = v / (u + v) := by
        rw [eq_div_iff h1, sub_mul, div_mul_cancel₀ _ h1]; ring
      rw [e, div_mul_eq_mul_div, div_mul_eq_mul_div, ← add_div, div_div_div_cancel_right₀ h1]
    exact (bayes hu hv).trans (by ring)

/-! ### Cylinder probabilities and the identification with the conditional expectation -/

theorem gmSeqMeasure_real_cylinder {θ p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) (n : ℕ)
    (h : Fin n → Bool) (s : Bool) :
    (gmSeqMeasure θ p).real ({s} ×ˢ {τ | ∀ i : Fin n, gmDirection s (τ i) = h i}) =
      (gmBern θ).real {s} * ∏ i, gmLik p s (h i) := by
  classical
  let h' : ℕ → Bool := fun j ↦ if hj : j < n then h ⟨j, hj⟩ else false
  have hset : {τ : ℕ → GMTrader | ∀ i : Fin n, gmDirection s (τ i) = h i} =
      Set.pi (Finset.range n : Set ℕ) (fun j ↦ {t | gmDirection s t = h' j}) := by
    ext τ
    simp only [Set.mem_ofPred_eq, Set.mem_pi, Finset.coe_range, Set.mem_Iio, h']
    exact ⟨fun H j hj ↦ by simpa [hj] using H ⟨j, hj⟩, fun H i ↦ by simpa using H i i.2⟩
  have hmeas : ∀ j ∈ Finset.range n, MeasurableSet {t : GMTrader | gmDirection s t = h' j} :=
    fun j _ ↦ (measurable_of_finite (gmDirection s)) (measurableSet_singleton _)
  rw [gmSeqMeasure, measureReal_prod_prod, hset]
  congr 1
  have key := Measure.infinitePi_pi (μ := fun _ : ℕ ↦ gmTraderLaw p) (s := Finset.range n)
    (t := fun j ↦ {t | gmDirection s t = h' j}) hmeas
  rw [measureReal_def, key, ENNReal.toReal_prod]
  rw [Finset.prod_range (fun j ↦ ((gmTraderLaw p) {t | gmDirection s t = h' j}).toReal)]
  refine Finset.prod_congr rfl fun i _ ↦ ?_
  rw [← measureReal_def, gmTraderLaw_real hp0 hp1]
  simp [h']

/-- **The dealer's quote is the conditional expectation of the value given the order history.**
For every `n`, `gmQuote n` is `P`-almost surely `P[V | 𝓖 n]`, where `V` is the two-valued asset
`V_H` on the high-value event and `V_L` off it, and `𝓖 n` is generated by the first `n` order
directions. -/
theorem gmQuote_ae_eq_condExp {θ p : ℝ} (hθ0 : 0 < θ) (hθ1 : θ < 1) (hp0 : 0 ≤ p) (hp1 : p < 1)
    (VL VH : ℝ) (n : ℕ) :
    (gmSeqMeasure θ p)[payoff gmSeqHigh VL VH | gmFiltration n]
      =ᵐ[gmSeqMeasure θ p] gmQuote θ p VL VH n := by
  set P := gmSeqMeasure θ p with hP
  have hint : Integrable (payoff gmSeqHigh VL VH) P :=
    (integrable_const VL).add ((integrable_const _).indicator measurableSet_gmSeqHigh)
  refine condExp_comap_ae_eq_of_fibres P (measurable_gmHist n) hint
    (fun h ↦ VL + gmBelief θ p (List.ofFn h) * (VH - VL)) fun h ↦ ?_
  have hfm : MeasurableSet (gmHist n ⁻¹' {h}) :=
    measurable_gmHist n (measurableSet_singleton h)
  set A := ∏ i, gmLik p true (h i) with hAdef
  set C := ∏ i, gmLik p false (h i) with hCdef
  have hAp : 0 < A := Finset.prod_pos fun i _ ↦ gmLik_pos hp0 hp1 _ _
  have hCp : 0 < C := Finset.prod_pos fun i _ ↦ gmLik_pos hp0 hp1 _ _
  have hT : P.real (gmHist n ⁻¹' {h} ∩ gmSeqHigh) = θ * A := by
    have : gmHist n ⁻¹' {h} ∩ gmSeqHigh =
        {true} ×ˢ {τ | ∀ i : Fin n, gmDirection true (τ i) = h i} := by
      ext ⟨s, τ⟩; cases s <;> simp [gmHist, gmSeqHigh, funext_iff]
    rw [this, hP, gmSeqMeasure_real_cylinder hp0 hp1.le, gmBern_real_true hθ0.le hθ1.le]
  have hF : P.real (gmHist n ⁻¹' {h} \ gmSeqHigh) = (1 - θ) * C := by
    have : gmHist n ⁻¹' {h} \ gmSeqHigh =
        {false} ×ˢ {τ | ∀ i : Fin n, gmDirection false (τ i) = h i} := by
      ext ⟨s, τ⟩; cases s <;> simp [gmHist, gmSeqHigh, funext_iff]
    rw [this, hP, gmSeqMeasure_real_cylinder hp0 hp1.le, gmBern_real_false hθ0.le hθ1.le]
  have hsplit : P.real (gmHist n ⁻¹' {h} ∩ gmSeqHigh) + P.real (gmHist n ⁻¹' {h} \ gmSeqHigh)
      = P.real (gmHist n ⁻¹' {h}) := measureReal_inter_add_sdiff measurableSet_gmSeqHigh
  have hI : ∫ ω in gmHist n ⁻¹' {h}, payoff gmSeqHigh VL VH ω ∂P =
      P.real (gmHist n ⁻¹' {h}) * VL + P.real (gmHist n ⁻¹' {h} ∩ gmSeqHigh) * (VH - VL) := by
    unfold payoff
    rw [integral_add (integrable_const VL)
      ((integrable_const _).indicator measurableSet_gmSeqHigh), setIntegral_const,
      setIntegral_indicator measurableSet_gmSeqHigh, setIntegral_const]
    simp [smul_eq_mul]
  have hB : gmBelief θ p (List.ofFn h) = θ * A / (θ * A + (1 - θ) * C) := by
    rw [gmBelief_eq hp0 hp1 _ θ hθ0 hθ1, List.map_ofFn, List.map_ofFn, List.prod_ofFn,
      List.prod_ofFn]
    rfl
  have hpos : 0 < θ * A + (1 - θ) * C :=
    add_pos (mul_pos hθ0 hAp) (mul_pos (sub_pos.2 hθ1) hCp)
  rw [hI, ← hsplit, hT, hF, hB]
  field_simp

/-- **The dealer's measure prices the market of quotes.** The dealer's quote process is
`P`-almost surely the conditional expectation process `n ↦ P[V | 𝓖 n]`, and `P` is a pricing
measure, at every horizon `T`, of the discrete market whose asset is that process (a
`P`-martingale). -/
theorem gmQuote_isPricingMeasure {θ p : ℝ} (hθ0 : 0 < θ) (hθ1 : θ < 1) (hp0 : 0 ≤ p)
    (hp1 : p < 1) (VL VH : ℝ) (T : ℕ) :
    (∀ n, gmQuote θ p VL VH n =ᵐ[gmSeqMeasure θ p]
        (gmSeqMeasure θ p)[payoff gmSeqHigh VL VH | gmFiltration n]) ∧
      (Contracts.DiscreteMarket.toMarket (gmSeqMeasure θ p) gmFiltration
        (fun n ↦ (gmSeqMeasure θ p)[payoff gmSeqHigh VL VH | gmFiltration n]) T
        fun _ _ ↦ stronglyMeasurable_condExp).IsPricingMeasure T (gmSeqMeasure θ p) :=
  ⟨fun n ↦ (gmQuote_ae_eq_condExp hθ0 hθ1 hp0 hp1 VL VH n).symm,
    isPricingMeasure_toMarket_condExp _ gmFiltration _ T⟩

/-! ### One order: the sequential quote is the posited ask and bid -/

/-- The first order is a buy: the event `{gmHist 1 = (true)}`. -/
def gmFirstBuy : Set (Bool × (ℕ → GMTrader)) := gmHist 1 ⁻¹' {fun _ ↦ true}

theorem measurableSet_gmFirstBuy : MeasurableSet gmFirstBuy :=
  measurable_gmHist 1 (measurableSet_singleton _)

/-- **After one order the dealer's information is the first order's direction**: `𝓖 1` is the
σ-algebra `σ(B)` generated by the event `B = gmFirstBuy` that it is a buy. -/
theorem gmFiltration_one : gmFiltration 1 = generateFrom {gmFirstBuy} := by
  have dich (f : Fin 1 → Bool) : f = (fun _ ↦ true) ∨ f = (fun _ ↦ false) := by
    cases h : f 0
    · right
      funext i
      rw [Subsingleton.elim i 0]
      exact h
    · left
      funext i
      rw [Subsingleton.elim i 0]
      exact h
  have hne : (fun _ : Fin 1 ↦ false) ≠ (fun _ ↦ true) := fun h ↦ by simpa using congrFun h 0
  refine le_antisymm (fun t ht ↦ ?_) (generateFrom_le fun t ht ↦ ?_)
  · change MeasurableSet[MeasurableSpace.comap (gmHist 1) inferInstance] t at ht
    obtain ⟨s, -, rfl⟩ := ht
    have hB : MeasurableSet[generateFrom {gmFirstBuy}] gmFirstBuy :=
      measurableSet_generateFrom (Set.mem_singleton _)
    have hset : gmHist 1 ⁻¹' s = (gmFirstBuy ∩ {_ω | (fun _ : Fin 1 ↦ true) ∈ s}) ∪
        (gmFirstBuyᶜ ∩ {_ω | (fun _ : Fin 1 ↦ false) ∈ s}) := by
      ext ω
      simp only [Set.mem_preimage, Set.mem_union, Set.mem_inter_iff, Set.mem_setOf_eq,
        Set.mem_compl_iff, gmFirstBuy, Set.mem_singleton_iff]
      rcases dich (gmHist 1 ω) with h | h <;> simp [h, hne]
    rw [hset]
    exact (hB.inter (.const _)).union (hB.compl.inter (.const _))
  · rw [Set.mem_singleton_iff.mp ht]
    change MeasurableSet[MeasurableSpace.comap (gmHist 1) inferInstance] gmFirstBuy
    exact MeasurableSpace.measurableSet_comap.2 ⟨{fun _ ↦ true}, measurableSet_singleton _, rfl⟩

/-- **The sequential quote after one order is the one-trade quote.** In the sequential
Glosten–Milgrom model, the dealer's quote after the first order is, `P`-almost surely, the ask
`∫ V ∂P[|B]` if the order is a buy (`B = gmFirstBuy`) and the bid `∫ V ∂P[|Bᶜ]` if it is a sell:
the quotes that `condExp_payoff_eq_quote` identifies with `P[V | σ(B)]`. -/
theorem gmQuote_one_ae_eq_quote {θ p : ℝ} (hθ0 : 0 < θ) (hθ1 : θ < 1) (hp0 : 0 ≤ p)
    (hp1 : p < 1) (VL VH : ℝ) [DecidablePred (· ∈ gmFirstBuy)] :
    gmQuote θ p VL VH 1 =ᵐ[gmSeqMeasure θ p] gmFirstBuy.piecewise
      (fun _ ↦ ∫ ω, payoff gmSeqHigh VL VH ω ∂(gmSeqMeasure θ p)[|gmFirstBuy])
      (fun _ ↦ ∫ ω, payoff gmSeqHigh VL VH ω ∂(gmSeqMeasure θ p)[|gmFirstBuyᶜ]) := by
  have h1 := (gmQuote_isPricingMeasure hθ0 hθ1 hp0 hp1 VL VH 1).1 1
  rw [gmFiltration_one] at h1
  exact h1.trans (condExp_payoff_eq_quote (gmSeqMeasure θ p) measurableSet_gmSeqHigh
    measurableSet_gmFirstBuy VL VH)

end MathFin.Execution
