module

public import MathFin.Models.StochVol.Heston.Definitions
public import Mathlib.Analysis.SpecialFunctions.Exponential
public import Mathlib.Analysis.Normed.Algebra.Exponential
public import Mathlib.Analysis.Complex.RealDeriv
public import Mathlib.Analysis.Calculus.Deriv.Linear
public import Mathlib.Analysis.Calculus.Deriv.Comp
public import Mathlib.Analysis.Calculus.Deriv.Prod
public import Mathlib.Analysis.Calculus.FDeriv.Linear
public import Mathlib.Analysis.Calculus.FDeriv.CompCLM
public import Mathlib.Topology.Algebra.Module.ContinuousLinearMap.PiProd
public import Mathlib.Analysis.Normed.Operator.ContinuousLinearMap

/-!
# Global Linear Flow for Two-Dimensional Linear Differential Systems

This file constructs the global flow for the 2D constant-coefficient linear system:
  d/dt [P(t); Q(t)] = [b, c; -a, 0] [P(t); Q(t)]
with initial condition (w, 1).

The linear flow is defined globally on `ℝ` (and `ℂ`) via the operator exponential
`NormedSpace.exp (t • A) (w, 1)` on `(Complex × Complex) →L[Complex] (Complex × Complex)`.

Key results:
1. `linearSystemP_zero`, `linearSystemQ_zero`: Exact initial values P(0) = w, Q(0) = 1.
2. `hasDerivAt_linearSystemFlow`: Global vector derivative `flow' = A(flow)`.
3. `hasDerivAt_linearSystemP`, `hasDerivAt_linearSystemQ`: Projected scalar derivatives for P and Q.
4. `linearSystemFlow_ne_zero`: Nonvanishing of the state vector `∀ t, flow(t) ≠ 0`,
   deduced from the group invertibility of the matrix exponential (`exp(-t•A) * exp(t•A) = 1`).

## Main definitions

* `linearSystemFlow`
* `linearSystemP`
* `linearSystemQ`

## Main results

* `hasDerivAt_linearSystemFlow`
* `hasDerivAt_linearSystemP`
* `hasDerivAt_linearSystemQ`

## References

* [S. Heston, *A closed-form solution for options with stochastic volatility*][Heston1993]

## Tags

Heston model, stochastic volatility, MSC 91G20, JEL G13
-/

@[expose] public section

noncomputable section
namespace MathFin.Heston

open ContinuousLinearMap

abbrev StateSpace : Type := Complex × Complex

/-- The 2x2 continuous linear generator `A(P, Q) = (b * P + c * Q, -a * P)`. -/
def linearSystemOperator (a : Real) (b c : Complex) : StateSpace →L[Complex] StateSpace :=
  (b • fst Complex Complex Complex + c • snd Complex Complex Complex).prod
  ((-(a : Complex)) • fst Complex Complex Complex)

@[simp]
theorem linearSystemOperator_apply (a : Real) (b c : Complex) (v : StateSpace) :
    linearSystemOperator a b c v = (b * v.1 + c * v.2, -(a : Complex) * v.1) := by
  rfl

/-- The initial state vector `(w, 1)`. -/
def linearSystemInit (w : Complex) : StateSpace := (w, 1)

@[simp]
theorem linearSystemInit_fst (w : Complex) : (linearSystemInit w).1 = w := rfl

@[simp]
theorem linearSystemInit_snd (w : Complex) : (linearSystemInit w).2 = 1 := rfl

/-- Complex-time linear flow generated by `exp(z • A) (w, 1)`. -/
def linearSystemFlowComplex (a : Real) (b c w : Complex) (z : Complex) : StateSpace :=
  NormedSpace.exp (z • linearSystemOperator a b c) (linearSystemInit w)

/-- Real-time linear flow restriction `t ↦ exp(t • A) (w, 1)`. -/
def linearSystemFlow (a : Real) (b c w : Complex) (t : Real) : StateSpace :=
  linearSystemFlowComplex a b c w (t : Complex)

/-- First component of the linear flow `P(t)`. -/
def linearSystemP (a : Real) (b c w : Complex) (t : Real) : Complex :=
  (linearSystemFlow a b c w t).1

/-- Second component of the linear flow `Q(t)`. -/
def linearSystemQ (a : Real) (b c w : Complex) (t : Real) : Complex :=
  (linearSystemFlow a b c w t).2

@[simp]
theorem linearSystemFlowComplex_zero (a : Real) (b c w : Complex) :
    linearSystemFlowComplex a b c w 0 = linearSystemInit w := by
  have hz : (0 : Complex) • linearSystemOperator a b c = 0 := by
    apply ContinuousLinearMap.ext
    intro v
    change ((0 : Complex) * (linearSystemOperator a b c v).1,
      (0 : Complex) * (linearSystemOperator a b c v).2) = (0, 0)
    simp only [zero_mul]
  change (NormedSpace.exp ((0 : Complex) • linearSystemOperator a b c)) _ = _
  rw [hz, NormedSpace.exp_zero]
  rfl

@[simp]
theorem linearSystemFlow_zero (a : Real) (b c w : Complex) :
    linearSystemFlow a b c w 0 = linearSystemInit w := by
  have h : ((0 : Real) : Complex) = 0 := Complex.ofReal_zero
  rw [linearSystemFlow, h, linearSystemFlowComplex_zero]

@[simp]
theorem linearSystemP_zero (a : Real) (b c w : Complex) :
    linearSystemP a b c w 0 = w := by
  dsimp [linearSystemP]
  rw [linearSystemFlow_zero]
  rfl

@[simp]
theorem linearSystemQ_zero (a : Real) (b c w : Complex) :
    linearSystemQ a b c w 0 = 1 := by
  dsimp [linearSystemQ]
  rw [linearSystemFlow_zero]
  rfl

/-- The state vector never vanishes at any complex time. -/
theorem linearSystemFlowComplex_ne_zero (a : Real) (b c w : Complex) (z : Complex) :
    linearSystemFlowComplex a b c w z ≠ 0 := by
  letI : NormedAlgebra ℚ (StateSpace →L[Complex] StateSpace) :=
    NormedAlgebra.restrictScalars ℚ ℂ _
  intro h
  let A := linearSystemOperator a b c
  let M := NormedSpace.exp (z • A)
  let Minv := NormedSpace.exp (-(z • A))
  have hcomm : Commute (-(z • A)) (z • A) := (Commute.refl (z • A)).neg_left
  have hinv : Minv * M = 1 := by
    calc
      Minv * M = NormedSpace.exp (-(z • A) + (z • A)) := (NormedSpace.exp_add_of_commute hcomm).symm
      _ = NormedSpace.exp 0 := by rw [neg_add_cancel]
      _ = 1 := NormedSpace.exp_zero
  have hzero : Minv (M (linearSystemInit w)) = 0 := by
    have hM : M (linearSystemInit w) = 0 := h
    rw [hM, map_zero]
  have hid : Minv (M (linearSystemInit w)) = linearSystemInit w := by
    change (Minv * M) (linearSystemInit w) = linearSystemInit w
    rw [hinv]
    rfl
  have hcontra : linearSystemInit w = 0 := by
    rw [← hid, hzero]
  have hsecond : (linearSystemInit w).2 = (0 : StateSpace).2 := by
    rw [hcontra]
  have hone : (1 : Complex) = 0 := hsecond
  exact one_ne_zero hone

/-- The state vector never vanishes at any real time. -/
theorem linearSystemFlow_ne_zero (a : Real) (b c w : Complex) (t : Real) :
    linearSystemFlow a b c w t ≠ 0 :=
  linearSystemFlowComplex_ne_zero a b c w (t : Complex)

/-- Complex-time derivative of the operator exponential applied to the initial vector. -/
theorem hasDerivAt_linearSystemFlowComplex (a : Real) (b c w : Complex) (z : Complex) :
    HasDerivAt (linearSystemFlowComplex a b c w)
      (linearSystemOperator a b c (linearSystemFlowComplex a b c w z)) z := by
  let A := linearSystemOperator a b c
  have h_exp : HasDerivAt (fun u : Complex => NormedSpace.exp (u • A))
      (A * NormedSpace.exp (z • A)) z :=
    hasDerivAt_exp_smul_const' A z
  have hu : HasDerivAt (fun _ : Complex => linearSystemInit w) 0 z :=
    hasDerivAt_const z (linearSystemInit w)
  have h_apply := h_exp.clm_apply hu
  simpa only [linearSystemFlowComplex, mul_apply_eq_comp, map_zero, add_zero, A] using! h_apply

/-- Real-time derivative of the linear flow `d/dt flow(t) = A (flow(t))`. -/
theorem hasDerivAt_linearSystemFlow (a : Real) (b c w : Complex) (t : Real) :
    HasDerivAt (linearSystemFlow a b c w)
      (linearSystemOperator a b c (linearSystemFlow a b c w t)) t := by
  have hi : HasDerivAt (fun s : Real => (s : Complex)) (1 : Complex) t := by
    simpa only [Complex.ofRealCLM_apply, Complex.ofReal_one] using!
      Complex.ofRealCLM.hasDerivAt (x := t)
  have hh := (hasDerivAt_linearSystemFlowComplex a b c w (t : Complex)).scomp t hi
  simpa only [linearSystemFlow, Function.comp_def, one_smul] using! hh

/-- Projected derivative of the first component `P'(t) = b * P(t) + c * Q(t)`. -/
theorem hasDerivAt_linearSystemP (a : Real) (b c w : Complex) (t : Real) :
    HasDerivAt (linearSystemP a b c w)
      (b * linearSystemP a b c w t + c * linearSystemQ a b c w t) t := by
  let fstCLM : StateSpace →L[ℝ] Complex := fst ℝ Complex Complex
  have h_fst := fstCLM.hasFDerivAt.comp_hasDerivAt t (hasDerivAt_linearSystemFlow a b c w t)
  have h_eq : (fstCLM (linearSystemOperator a b c (linearSystemFlow a b c w t))) =
      b * linearSystemP a b c w t + c * linearSystemQ a b c w t := by
    simp only [fstCLM, coe_fst', linearSystemOperator_apply, linearSystemP, linearSystemQ]
  rw [← h_eq]
  exact h_fst

/-- Projected derivative of the second component `Q'(t) = -a * P(t)`. -/
theorem hasDerivAt_linearSystemQ (a : Real) (b c w : Complex) (t : Real) :
    HasDerivAt (linearSystemQ a b c w)
      (-(a : Complex) * linearSystemP a b c w t) t := by
  let sndCLM : StateSpace →L[ℝ] Complex := snd ℝ Complex Complex
  have h_snd := sndCLM.hasFDerivAt.comp_hasDerivAt t (hasDerivAt_linearSystemFlow a b c w t)
  have h_eq : (sndCLM (linearSystemOperator a b c (linearSystemFlow a b c w t))) =
      -(a : Complex) * linearSystemP a b c w t := by
    simp only [sndCLM, coe_snd', linearSystemOperator_apply, linearSystemP]
  rw [← h_eq]
  exact h_snd

end MathFin.Heston
