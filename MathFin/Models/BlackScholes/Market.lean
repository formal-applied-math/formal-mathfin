module

public import MathFin.Models.BlackScholes.BlackScholesPhysical
public import MathFin.Pricing.FTAP.MarketFTAP
public import MathFin.Pricing.Market
public import MathFin.Probability.Brownian.BrownianMartingale

/-!
# The Black–Scholes market

The Black–Scholes model as a `Market` (`BlackScholes.market`): a pre-Brownian motion `W` (a
Brownian motion without the path-continuity requirement) under the physical measure `μ`, the
information it generates (`natFiltration`), one traded asset
`S_t = S₀ exp((m − σ²/2)t + σ W_t)` with physical drift `m`, and the money market `e^{rt}` as
numéraire. The deflated asset is `S₀ exp((m − r − σ²/2)t + σ W_t)` (`deflated_market`).

The Girsanov measure `Q` of the constant market price of risk `θ = (m − r)/σ`
(`constGirsanovMeasure`, `Models/BlackScholes/BlackScholesPhysical.lean`) is a pricing measure at
every horizon `T` up to the Girsanov horizon `H` (`isPricingMeasure_constGirsanovMeasure`). It is
equivalent to `μ`, its density being a positive exponential. Under it the drift-corrected process
`B^θ` is a Brownian motion for the filtration of `W`, and on `[0, H]` the deflated asset is almost
surely `S₀ exp(σ B^θ_t − σ²t/2)`, the Wald exponential martingale of `B^θ`
(`IsFilteredPreBrownian.waldExponential_isMartingale`).

The price of a contract in this market is its value with the discount `e^{−rt}` on the physical
asset (`price_market`); under `Q` the European call is worth the Black–Scholes formula
(`price_europeanCall_constGirsanovMeasure`). That `Q` is the only pricing measure on `𝓕 T` is not
proved here: it is the uniqueness half of the completeness argument of
`Pricing/MarketCompleteness.lean`, which needs the gains of a strategy to be fair under every
pricing measure.

The Black–Scholes market has no arbitrage on any grid of dates inside the Girsanov horizon
(`noArbitrage_market`): a pricing measure rules out arbitrage
(`Market.IsPricingMeasure.noArbitrage`).

## Main definitions

* `MathFin.Contracts.BlackScholes.market`: the Black–Scholes market of a pre-Brownian motion `W`,
  with spot `S₀`, physical drift `m`, rate `r` and volatility `σ`.

## Main results

* `MathFin.Contracts.BlackScholes.deflator_market`, `deflated_market`: the deflator is `e^{−rt}`
  and the deflated asset `S₀ exp((m − r − σ²/2)t + σ W_t)`.
* `MathFin.Contracts.BlackScholes.isEquivProbMeasure_constGirsanovMeasure`: the Girsanov measure
  of a constant price of risk is equivalent to `μ`.
* `MathFin.Contracts.BlackScholes.isPricingMeasure_constGirsanovMeasure`: for `σ ≠ 0` the
  Girsanov measure of `θ = (m − r)/σ` at a horizon `H` is a pricing measure at every `T ≤ H`.
* `MathFin.Contracts.BlackScholes.noArbitrage_market`: for `σ ≠ 0` the market has no arbitrage on
  any grid of dates up to the horizon `H`.
* `MathFin.Contracts.BlackScholes.price_market`: a contract's price is its value with the discount
  `e^{−rt}` on the physical asset.
* `MathFin.Contracts.BlackScholes.price_europeanCall_constGirsanovMeasure`: under that pricing
  measure the European call is worth `S₀ Φ(d₁) − K e^{−rT} Φ(d₂)`.
* `MathFin.Contracts.BlackScholes.price_europeanPut_constGirsanovMeasure`: under the same
  pricing measure the European put is worth `K e^{−rT} Φ(−d₂) − S₀ Φ(−d₁)`.

## References

* [F. Black and M. Scholes, *The pricing of options and corporate liabilities*][BlackScholes1973]
* [S. E. Shreve, *Stochastic Calculus for Finance II: Continuous-Time Models*][ShreveSCFII], 5.2
* [Y. F. Saporito, *Stochastic Processes*][Saporito], Theorem 9.1.8

## Tags

Black–Scholes market, pricing measure, Girsanov theorem, market price of risk, risk-neutral
valuation, European call, MSC 91G20, MSC 60H05, JEL G13
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Real
open scoped NNReal ENNReal
open MathFin ItoIntegralL2 ItoIntegralProcessContinuousModification

namespace MathFin.Contracts.BlackScholes

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {W : ℝ≥0 → Ω → ℝ}

/-- **The Black–Scholes market** of a pre-Brownian motion `W` under the physical measure `μ`: the
information generated by `W`, the asset `S₀ exp((m − σ²/2)t + σ W_t)` and the money market
`e^{rt}` as numéraire. -/
noncomputable def market (μ : Measure Ω) (hWmeas : ∀ t, Measurable (W t)) (S_0 m r σ : ℝ) :
    Market Unit Ω where
  P := μ
  𝓕 := natFiltration hWmeas
  asset := pathAssets S_0 m σ W
  numeraire t _ := Real.exp (r * t)
  numeraire_pos _ _ := Real.exp_pos _
  asset_adapted _ t := ((((stronglyAdapted_natFiltration hWmeas t).measurable.const_mul
    σ).const_add ((m - σ ^ 2 / 2) * (t : ℝ))).exp.const_mul S_0).stronglyMeasurable
  numeraire_adapted _ := stronglyMeasurable_const

section Market

variable (μ : Measure Ω) (hWmeas : ∀ t, Measurable (W t)) (S_0 m r σ : ℝ)

/-- The deflator of the Black–Scholes market is the discount `e^{−rt}`. -/
theorem deflator_market (t : ℝ≥0) (ω : Ω) :
    (market μ hWmeas S_0 m r σ).deflator t ω = Real.exp (-r * t) := by
  simp only [Market.deflator, market, NNReal.coe_zero, mul_zero, Real.exp_zero, one_div, neg_mul,
    Real.exp_neg]

/-- The deflated asset of the Black–Scholes market is `S₀ exp((m − r − σ²/2)t + σ W_t)`. -/
theorem deflated_market (t : ℝ≥0) (ω : Ω) :
    (market μ hWmeas S_0 m r σ).deflated () t ω
      = S_0 * Real.exp ((m - r - σ ^ 2 / 2) * t + σ * W t ω) := by
  simp only [Market.deflated, market, pathAssets]
  rw [mul_div_assoc S_0, ← Real.exp_sub]
  congr 2
  ring

/-- **The price of a contract in the Black–Scholes market** is its value with the discount
`e^{−rt}` on the physical asset, under any measure. -/
theorem price_market (Q : Measure Ω) (c : Contract Unit) :
    (market μ hWmeas S_0 m r σ).price Q c
      = c.value Q (fun t _ ↦ Real.exp (-r * t)) (pathAssets S_0 m σ W) :=
  congrArg (fun D ↦ c.value Q D (pathAssets S_0 m σ W))
    (funext fun t ↦ funext (deflator_market μ hWmeas S_0 m r σ t))

end Market

variable {μ : Measure Ω} [IsProbabilityMeasure μ] (hW : IsPreBrownianReal W μ)
  (hWmeas : ∀ t, Measurable (W t)) {S_0 m r σ : ℝ}

/-- **The Girsanov measure of a constant market price of risk is equivalent to the physical
measure**: its density `Z_H` is a positive exponential (`contDoleansExp_pos`). -/
theorem isEquivProbMeasure_constGirsanovMeasure (θ : ℝ) (H : ℝ≥0) :
    IsEquivProbMeasure μ (constGirsanovMeasure hW hWmeas θ H) := by
  obtain ⟨V, hV⟩ := exists_approxSeq (μ := μ) hWmeas H (isStronglyPredictable_const hWmeas θ)
    (fun _ _ ↦ le_rfl)
  exact isEquivProbMeasure_withDensity_of_isProbabilityMeasure μ
    (memLp_ZTpred_one hW hWmeas H (isStronglyPredictable_const hWmeas θ) (fun _ _ ↦ le_rfl) V
      hV).aestronglyMeasurable.aemeasurable
    (.of_forall fun _ ↦ contDoleansExp_pos _ _ _ _)
    (constGirsanovMeasure_isProbabilityMeasure hW hWmeas θ H)

/-- **The Girsanov measure is a pricing measure of the Black–Scholes market.** For `σ ≠ 0` the
Girsanov measure `Q` of the market price of risk `θ = (m − r)/σ` at a horizon `H` prices the market
at every horizon `T ≤ H`. It is equivalent to `μ`
(`isEquivProbMeasure_constGirsanovMeasure`), and before `H` the deflated asset is almost surely
`S₀ exp(σ B^θ_t − σ²t/2)` (`pathAssets_physical_ae_eq`), a martingale since `B^θ` is a Brownian
motion for the filtration under `Q` (`isFilteredPreBrownian_constBtheta`,
`IsFilteredPreBrownian.waldExponential_isMartingale`). -/
theorem isPricingMeasure_constGirsanovMeasure (hσ : σ ≠ 0) {T H : ℝ≥0} (hTH : T ≤ H) :
    (market μ hWmeas S_0 m r σ).IsPricingMeasure T
      (constGirsanovMeasure hW hWmeas ((m - r) / σ) H) := by
  have := constGirsanovMeasure_isProbabilityMeasure hW hWmeas ((m - r) / σ) H
  have := isFilteredPreBrownian_constBtheta hW hWmeas ((m - r) / σ) H
  refine .of_isEquivProbMeasure (isEquivProbMeasure_constGirsanovMeasure hW hWmeas _ H)
    fun _ ↦ Martingale.congr_ae (martingale_min_of_martingale
      ((IsFilteredPreBrownian.waldExponential_isMartingale
        (X := constBtheta (μ := μ) hWmeas ((m - r) / σ) H) (𝓕 := natFiltration hWmeas)
        (P := constGirsanovMeasure hW hWmeas ((m - r) / σ) H) σ).smul S_0) T)
      (fun t ↦ ((market μ hWmeas S_0 m r σ).stronglyAdapted_deflated () (min t T)).mono
        ((market μ hWmeas S_0 m r σ).𝓕.mono (min_le_left t T))) fun t ↦ ?_
  filter_upwards [pathAssets_physical_ae_eq hW hWmeas (S_0 := S_0) (m := m) (r := r) hσ H
    ((min_le_right t T).trans hTH)] with ω hω
  simp only [Pi.smul_apply, smul_eq_mul, Market.deflated, market]
  rw [hω]
  simp only [pathAssets]
  rw [mul_div_assoc S_0, ← Real.exp_sub]
  congr 2
  ring

/-- **The European call in the Black–Scholes market** is worth the Black–Scholes formula
`S₀ Φ(d₁) − K e^{−rT} Φ(d₂)` under the Girsanov pricing measure of `θ = (m − r)/σ` at a horizon
`H ≥ T` (`isPricingMeasure_constGirsanovMeasure`), whatever the physical drift `m`: the price is the
call's value on the physical asset with the discount `e^{−rt}` (`price_market`), which only reads
the discount at `T` (`Contract.pathPV_congr`), and that value is `value_europeanCall_physical`. -/
theorem price_europeanCall_constGirsanovMeasure {K : ℝ} {T H : ℝ≥0} (hTH : T ≤ H)
    (hS₀ : 0 < S_0) (hK : 0 < K) (hσ : 0 < σ) (hT : 0 < (T : ℝ)) :
    (market μ hWmeas S_0 m r σ).price (constGirsanovMeasure hW hWmeas ((m - r) / σ) H)
        (europeanCall K T)
      = S_0 * Phi (bsd1 S_0 K r σ T) - K * Real.exp (-r * T) * Phi (bsd2 S_0 K r σ T) := by
  rw [price_market, ← value_europeanCall_physical hW hWmeas (m := m) hTH hS₀ hK hσ hT]
  unfold Contract.value
  refine integral_congr_ae (.of_forall fun ω ↦ (europeanCall K T).pathPV_congr
    (by simp [europeanCall, Contract.FixedDated]) (fun t ht ↦ ?_) fun _ _ ↦ rfl)
  obtain rfl : t = T := by simpa [europeanCall, Contract.dates] using ht
  rfl

/-- **The European put in the Black–Scholes market** is worth the Black–Scholes put formula
`K e^{−rT} Φ(−d₂) − S₀ Φ(−d₁)` under the same Girsanov pricing measure as the call
(`price_europeanCall_constGirsanovMeasure`), by the identical route: the price is the put's
value on the physical asset (`price_market`), and that value is `value_europeanPut_physical`. -/
theorem price_europeanPut_constGirsanovMeasure {K : ℝ} {T H : ℝ≥0} (hTH : T ≤ H)
    (hS₀ : 0 < S_0) (hK : 0 < K) (hσ : 0 < σ) (hT : 0 < (T : ℝ)) :
    (market μ hWmeas S_0 m r σ).price (constGirsanovMeasure hW hWmeas ((m - r) / σ) H)
        (europeanPut K T)
      = K * Real.exp (-r * T) * Phi (-bsd2 S_0 K r σ T) - S_0 * Phi (-bsd1 S_0 K r σ T) := by
  rw [price_market, ← value_europeanPut_physical hW hWmeas (m := m) hTH hS₀ hK hσ hT]
  unfold Contract.value
  refine integral_congr_ae (.of_forall fun ω ↦ (europeanPut K T).pathPV_congr
    (by simp [europeanPut, Contract.FixedDated]) (fun t ht ↦ ?_) fun _ _ ↦ rfl)
  obtain rfl : t = T := by simpa [europeanPut, Contract.dates] using ht
  rfl

include hW in
/-- **The Black–Scholes market has no arbitrage on any grid inside the Girsanov horizon.** For
`σ ≠ 0` and dates `t 0 ≤ ⋯ ≤ t N ≤ H`, no bounded predictable strategy trading the deflated asset at
those dates is an arbitrage: the Girsanov measure is a pricing measure
(`isPricingMeasure_constGirsanovMeasure`), and a pricing measure rules out arbitrage
(`Market.IsPricingMeasure.noArbitrage`). -/
theorem noArbitrage_market (hσ : σ ≠ 0) {t : ℕ → ℝ≥0} (ht : Monotone t) {N : ℕ} {H : ℝ≥0}
    (hH : t N ≤ H) : (market μ hWmeas S_0 m r σ).NoArbitrage ht N :=
  haveI : IsFiniteMeasure (market μ hWmeas S_0 m r σ).P := inferInstanceAs (IsFiniteMeasure μ)
  (isPricingMeasure_constGirsanovMeasure hW hWmeas hσ (le_refl H)).noArbitrage ht hH

end MathFin.Contracts.BlackScholes
