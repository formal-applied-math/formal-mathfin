module

public import Mathlib

/-!
# CreditMetrics rating transitions

In the CreditMetrics methodology (J.P. Morgan, *CreditMetrics — Technical Document*, 1997, ch. 6)
an obligor's credit rating moves between finitely many states `ι` (AAA, AA, …, CCC, Default) once
per period, with migration probabilities given by a row-stochastic **transition matrix** `P`: the
entry `P i j` is the probability of moving from rating `i` to rating `j`. Mathlib's
`Matrix.rowStochastic ℝ ι` is exactly this object, and it is a submonoid of `Matrix ι ι ℝ`.

* **Multi-period migration.** The `k`-period transition matrix is `P ^ k`, again row-stochastic:
  this is `Submonoid.pow_mem` for Mathlib's submonoid.
* **Default is absorbing.** If no obligor leaves the Default state `d` (row `d` of `P` is the
  indicator of `d`), the probability `(P ^ k) i d` of being in default after `k` periods is
  monotone in `k` (`monotone_pow_apply_absorbing`).
* **Gaussian threshold migration.** Row `i` of the CreditMetrics matrix is generated by a
  latent standard normal return `Z`: with thresholds `-∞ = z 0 ≤ z 1 ≤ ⋯ ≤ z m = +∞`, the obligor
  lands in bucket `j` iff `z j < Z ≤ z (j + 1)` (`ratingBucket`). The buckets partition `ℝ`
  (`iUnion_ratingBucket`, `pairwise_disjoint_ratingBucket`), so their probabilities under any
  probability law sum to one, and a matrix built row by row this way is row-stochastic
  (`thresholdMatrix_mem_rowStochastic`); the CreditMetrics case is the law `N(0, 1)`,
  `thresholdMatrix_mem_rowStochastic (gaussianReal 0 1)`. This is one obligor's marginal
  migration; no copula (joint law of several obligors) is involved.

## Main results

* `monotone_pow_apply_absorbing`: the cumulative default probability is nondecreasing.
* `ratingBucket`, `thresholdMatrix`: the threshold construction.
* `thresholdMatrix_mem_rowStochastic`: threshold migration under any latent law gives a transition
  matrix.

The calibration of the thresholds to a given matrix (`z = Φ⁻¹` of cumulative row sums) and the
correlated multi-obligor migration are not formalized here.
-/

@[expose] public section

namespace MathFin

open Matrix MeasureTheory ProbabilityTheory Set

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-! ### Multi-period transitions and the absorbing default state -/

/-- If the state `d` (Default) is absorbing for the transition matrix `P`, the probability
`(P ^ k) i d` of having defaulted within `k` periods, starting from rating `i`, is monotone
in `k`. -/
theorem monotone_pow_apply_absorbing {P : Matrix ι ι ℝ} (hP : P ∈ rowStochastic ℝ ι) {d : ι}
    (hd : P d d = 1) (i : ι) : Monotone fun k : ℕ ↦ (P ^ k) i d := by
  refine monotone_nat_of_le_succ fun k ↦ ?_
  have hk : P ^ k ∈ rowStochastic ℝ ι := Submonoid.pow_mem _ hP k
  rw [pow_succ, mul_apply, ← Finset.add_sum_erase _ _ (Finset.mem_univ d), hd, mul_one]
  exact le_add_of_nonneg_right <| Finset.sum_nonneg fun j _ ↦
    mul_nonneg (nonneg_of_mem_rowStochastic hk) (nonneg_of_mem_rowStochastic hP)

/-! ### Threshold migration -/

variable {m : ℕ}

/-- The bucket `{x | z j < x ≤ z (j + 1)}` of latent returns that send the obligor to rating `j`,
for thresholds `z : Fin (m + 1) → EReal`. -/
def ratingBucket (z : Fin (m + 1) → EReal) (j : Fin m) : Set ℝ :=
  {x | z j.castSucc < x ∧ x ≤ z j.succ}

lemma measurableSet_ratingBucket (z : Fin (m + 1) → EReal) (j : Fin m) :
    MeasurableSet (ratingBucket z j) :=
  (measurableSet_lt measurable_const measurable_coe_real_ereal).inter
    (measurableSet_le measurable_coe_real_ereal measurable_const)

/-- Buckets of monotone thresholds are pairwise disjoint. -/
lemma pairwise_disjoint_ratingBucket {z : Fin (m + 1) → EReal} (hz : Monotone z) :
    Pairwise fun j k ↦ Disjoint (ratingBucket z j) (ratingBucket z k) := by
  have key (j k : Fin m) (hjk : j < k) : Disjoint (ratingBucket z j) (ratingBucket z k) :=
    Set.disjoint_left.2 fun x hj hk ↦
      (hj.2.trans (hz (Fin.succ_le_castSucc_iff.2 hjk))).not_gt hk.1
  exact fun j k hjk ↦ hjk.lt_or_gt.elim (key j k) fun h ↦ (key k j h).symm

/-- With `z 0 = ⊥` and `z (last m) = ⊤`, the buckets cover `ℝ`. -/
lemma iUnion_ratingBucket {z : Fin (m + 1) → EReal} (h0 : z 0 = ⊥) (hm : z (Fin.last m) = ⊤) :
    ⋃ j, ratingBucket z j = univ := by
  refine eq_univ_of_forall fun x ↦ mem_iUnion.2 ?_
  -- The first threshold at or above `x` closes the bucket containing `x`.
  set s := Finset.univ.filter fun k : Fin (m + 1) ↦ x ≤ z k
  have hs : s.Nonempty := ⟨Fin.last m, by simp [s, hm]⟩
  set k := s.min' hs
  have hk : x ≤ z k := (Finset.mem_filter.1 (s.min'_mem hs)).2
  have hk0 : k ≠ 0 := fun h ↦ by simp [h, h0] at hk
  obtain ⟨j, hj⟩ := Fin.exists_succ_eq.2 hk0
  refine ⟨j, not_le.1 fun hle ↦ ?_, hj ▸ hk⟩
  have : k ≤ j.castSucc := s.min'_le _ (by simp [s, hle])
  exact (Fin.castSucc_lt_succ (i := j)).not_ge (hj ▸ this)

/-- For thresholds `-∞ = z 0 ≤ ⋯ ≤ z m = +∞` and any probability law `μ` of the latent return,
the bucket probabilities sum to one. -/
theorem sum_measureReal_ratingBucket (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {z : Fin (m + 1) → EReal} (hz : Monotone z) (h0 : z 0 = ⊥) (hm : z (Fin.last m) = ⊤) :
    ∑ j, μ.real (ratingBucket z j) = 1 := by
  rw [← measureReal_iUnion_fintype (pairwise_disjoint_ratingBucket hz)
    (measurableSet_ratingBucket z), iUnion_ratingBucket h0 hm, probReal_univ]

/-- The transition matrix generated by row-wise thresholds `z i` and a latent-return law `μ`:
`thresholdMatrix μ z i j = μ(z i j < Z ≤ z i (j + 1))`. -/
noncomputable def thresholdMatrix (μ : Measure ℝ) (z : Fin m → Fin (m + 1) → EReal) :
    Matrix (Fin m) (Fin m) ℝ :=
  of fun i j ↦ μ.real (ratingBucket (z i) j)

/-- Threshold migration produces a valid transition matrix. -/
theorem thresholdMatrix_mem_rowStochastic (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {z : Fin m → Fin (m + 1) → EReal} (hz : ∀ i, Monotone (z i)) (h0 : ∀ i, z i 0 = ⊥)
    (hm : ∀ i, z i (Fin.last m) = ⊤) : thresholdMatrix μ z ∈ rowStochastic ℝ (Fin m) :=
  mem_rowStochastic_iff_sum.2
    ⟨fun _ _ ↦ measureReal_nonneg, fun i ↦ sum_measureReal_ratingBucket μ (hz i) (h0 i) (hm i)⟩

end MathFin
