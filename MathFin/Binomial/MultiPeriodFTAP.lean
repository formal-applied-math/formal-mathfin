module

public import MathFin.Binomial.PathMeasure
public import MathFin.Foundations.FTAPDiscrete

/-!
# Multi-period binomial no-arbitrage through the discrete FTAP

`Foundations/FTAPDiscrete.lean` proves the Harrison–Pliska theorem on a finite probability space
with a filtration: `NoArbitrage ↔ ∃ Q, IsEMM Q`. Here the `T`-period CRR tree is an instance.

* The sample space is `Fin T → Bool`, the first `T` coin flips, with the real-world measure
  `horizonMeasure T p = (coinFlipMeasure p).map (flips T)`: it has full support when `0 < p < 1`
  (`horizonMeasure_pos`), by the cylinder formula `coinFlipMeasure_flips_preimage`.
* The filtration is `horizonFiltration T`: `ℱₙ` is generated by the first `n` flips, frozen
  from time `T` on. Its pullback under `flips T` is the path-space `flipFiltration`
  (`comap_flips_horizonFiltration`), so the two are one notion on `[0, T]`.
* The discounted price is `horizonSpot T`: the discounted CRR spot `discountedSpot`, frozen
  at `T`.

The martingale property of `discountedSpot` under `coinFlipMeasure (crrUpProb u d r)`
(`martingale_discountedSpot`) transports along `flips T` to `IsEMM` for the finite market
(`isEMM_horizonSpot`), so `ftap_discrete` gives no arbitrage (`noArbitrage_horizonSpot`). The
converse is explicit: if `e^r ≤ d` or `u ≤ e^r`, holding `±1` unit over the first period is an
arbitrage (`binomialNoArb_of_noArbitrage`). Together:
`NoArbitrage ↔ BinomialNoArb u d r` for the multi-period tree (`noArbitrage_horizonSpot_iff`).

The martingale measure is unique (`IsEMM.eq_horizonMeasure`, `existsUnique_isEMM_horizonSpot`).
Node by node, on the atom `{y | y agrees with x on the first t flips}` of `ℱₜ`
(`horizonAtom`), the martingale property in set-integral form gives
`∫_A (S_{t+1} − S_t) dQ = 0`; on `A` the increment is `S_t(x) (e^{-r} u − 1)` or
`S_t(x) (e^{-r} d − 1)` according to flip `t`, which forces the conditional up-probability to
`crrUpProb` (`IsEMM.real_atom_flip`). Induction on the prefix length gives every atom its product
probability (`IsEMM.real_horizonAtom`), and at `t = T` the atoms are the paths, so `Q` is
`horizonMeasure T (crrUpProb u d r)` (`horizonMeasure_singleton`).

## Main results

* `horizonFiltration`, `horizonMeasure`, `horizonSpot` — the market.
* `comap_flips_horizonFiltration` — `flipFiltration` is the pullback of `horizonFiltration`.
* `isEMM_horizonSpot` — under `BinomialNoArb`, `horizonMeasure (crrUpProb)` is an equivalent
  martingale measure for every real-world `horizonMeasure p`, `0 < p < 1`.
* `noArbitrage_horizonSpot_iff` — `NoArbitrage ↔ BinomialNoArb u d r` (for `S₀ > 0`, `0 < d < u`,
  at least one period).
* `IsEMM.eq_horizonMeasure` — under `BinomialNoArb` and `S₀ > 0`, every `IsEMM` of the market is
  `horizonMeasure T (crrUpProb u d r)`; `existsUnique_isEMM_horizonSpot` packages existence and
  uniqueness.
-/

@[expose] public section

namespace MathFin

open MeasureTheory ProbabilityTheory Finset
open scoped ENNReal NNReal

section Market

variable (T : ℕ)

/-- The path `x` with every flip from time `n` on blanked (set to `false`). -/
def revealed (n : ℕ) (x : Fin T → Bool) : Fin T → Bool :=
  fun i ↦ if (i : ℕ) < n then x i else false

lemma measurable_revealed (n : ℕ) : Measurable (revealed T n) := measurable_of_countable _

/-- The **filtration of the `T`-period coin-flip market**: `ℱₙ = σ(ω₀, …, ω_{n−1})` on
`Fin T → Bool`, constant (the whole path) from time `T` on. -/
def horizonFiltration : Filtration ℕ (inferInstance : MeasurableSpace (Fin T → Bool)) where
  seq n := MeasurableSpace.comap (revealed T n) inferInstance
  mono' m n hmn := by
    have : revealed T m = revealed T m ∘ revealed T n := by
      funext x i
      simp only [revealed, Function.comp]
      split_ifs <;> first | rfl | omega
    dsimp only
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (Measurable.comap_le (measurable_revealed T m))
  le' n := (measurable_revealed T n).comap_le

/-- The first `T` flips as a path of length `T`, extended by `false`: a right inverse of `flips T`. -/
def padFlips (x : Fin T → Bool) : ℕ → Bool := fun k ↦ if h : k < T then x ⟨k, h⟩ else false

lemma flips_padFlips (x : Fin T → Bool) : flips T (padFlips T x) = x :=
  funext fun i ↦ by simp [flips, padFlips, i.2]

/-- **The pullback of the finite-horizon filtration is the path-space filtration.** On `[0, T]`
the natural flip filtration `flipFiltration` of `ℕ → Bool` is the preimage under `flips T` of
`horizonFiltration T`. -/
theorem comap_flips_horizonFiltration {t : ℕ} (ht : t ≤ T) :
    MeasurableSpace.comap (flips T) (horizonFiltration T t) = flipFiltration t := by
  refine le_antisymm ?_ ?_
  · -- `revealed t ∘ flips T` is a function of `flips t`
    change MeasurableSpace.comap (flips T) (MeasurableSpace.comap (revealed T t) _) ≤
      MeasurableSpace.comap (flips t) _
    rw [MeasurableSpace.comap_comp]
    have : revealed T t ∘ flips T =
        (fun y : Fin t → Bool ↦ fun i : Fin T ↦ if h : (i : ℕ) < t then y ⟨i, h⟩ else false) ∘
          flips t := by
      funext ω i
      by_cases h : (i : ℕ) < t <;> simp [revealed, flips, h]
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (Measurable.comap_le (measurable_of_countable _))
  · -- `flips t` is a function of `revealed t ∘ flips T`
    change MeasurableSpace.comap (flips t) _ ≤
      MeasurableSpace.comap (flips T) (MeasurableSpace.comap (revealed T t) _)
    rw [MeasurableSpace.comap_comp]
    have : flips t = (fun z : Fin T → Bool ↦ fun i : Fin t ↦ z ⟨i, lt_of_lt_of_le i.2 ht⟩) ∘
        (revealed T t ∘ flips T) := by
      funext ω i
      simp [revealed, flips, i.2]
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (Measurable.comap_le (measurable_of_countable _))

/-- The **real-world measure** of the `T`-period market: the law of the first `T` i.i.d.
`Bernoulli(q)` flips. -/
noncomputable def horizonMeasure (q : ℝ≥0) (hq : q ≤ 1) : Measure (Fin T → Bool) :=
  (coinFlipMeasure q hq).map (flips T)

instance (q : ℝ≥0) (hq : q ≤ 1) : IsProbabilityMeasure (horizonMeasure T q hq) :=
  Measure.isProbabilityMeasure_map (measurable_flips T).aemeasurable

lemma horizonMeasure_singleton (q : ℝ≥0) (hq : q ≤ 1) (x : Fin T → Bool) :
    horizonMeasure T q hq {x} = ∏ i, if x i then (q : ℝ≥0∞) else 1 - q := by
  rw [horizonMeasure, Measure.map_apply (measurable_flips T) (measurableSet_singleton x),
    coinFlipMeasure_flips_preimage]

/-- **Full support.** For `0 < q < 1` every path of the `T`-period market has positive
probability. -/
theorem horizonMeasure_pos {q : ℝ≥0} (hq0 : 0 < q) (hq1 : q < 1) (x : Fin T → Bool) :
    0 < horizonMeasure T q hq1.le {x} := by
  rw [horizonMeasure_singleton, pos_iff_ne_zero, Finset.prod_ne_zero_iff]
  intro i _
  split_ifs
  · exact_mod_cast hq0.ne'
  · exact (tsub_pos_iff_lt.2 (by exact_mod_cast hq1)).ne'

/-- The **discounted price** of the `T`-period market: the discounted CRR spot after `n ∧ T`
flips, the path extended by `false` beyond the horizon (which it does not read). -/
noncomputable def horizonSpot (S₀ u d r : ℝ) (n : ℕ) (x : Fin T → Bool) : ℝ :=
  discountedSpot S₀ u d r (min n T) (padFlips T x)

variable {T} {S₀ u d r : ℝ}

/-- Up to the horizon, the market price pulled back along `flips T` is the path-space price. -/
lemma horizonSpot_flips {n : ℕ} (hn : n ≤ T) (ω : ℕ → Bool) :
    horizonSpot T S₀ u d r n (flips T ω) = discountedSpot S₀ u d r n ω := by
  rw [horizonSpot, min_eq_left hn]
  exact pathAdaptedAt_discountedSpot S₀ u d r n _ _ fun i hi ↦ by
    simp [padFlips, flips, lt_of_lt_of_le hi hn]

lemma horizonSpot_revealed (n : ℕ) (x : Fin T → Bool) :
    horizonSpot T S₀ u d r n (revealed T n x) = horizonSpot T S₀ u d r n x :=
  pathAdaptedAt_discountedSpot S₀ u d r (min n T) _ _ fun i hi ↦ by
    have hiT : i < T := lt_of_lt_of_le hi (min_le_right n T)
    have hin : i < n := lt_of_lt_of_le hi (min_le_left n T)
    simp [padFlips, revealed, hiT, hin]

/-- The market price is adapted to `horizonFiltration`. -/
lemma stronglyAdapted_horizonSpot : StronglyAdapted (horizonFiltration T) (horizonSpot T S₀ u d r) :=
  fun n ↦ by
    have : horizonSpot T S₀ u d r n = horizonSpot T S₀ u d r n ∘ revealed T n :=
      funext fun x ↦ (horizonSpot_revealed n x).symm
    rw [this]
    exact ((measurable_of_countable _).comp
      (comap_measurable (revealed T n))).stronglyMeasurable

end Market

section NoArbitrage

variable {T : ℕ} {S₀ u d r : ℝ}

/-- Mutual absolute continuity from full support: a measure charging every point dominates every
measure on a measurable-singleton space. -/
private lemma absolutelyContinuous_of_pos {Ω : Type*} [MeasurableSpace Ω]
    [MeasurableSingletonClass Ω] {μ ν : Measure Ω} (h : ∀ x, 0 < ν {x}) : μ ≪ ν := by
  intro s hs
  by_contra hne
  obtain ⟨x, hx⟩ : s.Nonempty := Set.nonempty_iff_ne_empty.2 fun hs' ↦ hne (by rw [hs']; simp)
  exact (h x).not_ge ((measure_mono (Set.singleton_subset_iff.2 hx)).trans_eq hs)

/-- On a full-support space, a.e. equality is pointwise equality. -/
private lemma eq_of_ae_eq_of_pos {Ω : Type*} [MeasurableSpace Ω] [MeasurableSingletonClass Ω]
    {μ : Measure Ω} (hμ : ∀ x, 0 < μ {x}) {f g : Ω → ℝ} (h : f =ᵐ[μ] g) (x : Ω) :
    f x = g x := by
  by_contra hx
  exact (hμ x).not_ge ((measure_mono (show {x} ⊆ {y | ¬ f y = g y} by simpa)).trans_eq
    (ae_iff.1 h))

/-- **An equivalent martingale measure for the `T`-period tree.** Under `BinomialNoArb u d r`,
the law of the first `T` i.i.d. `Bernoulli(q)` flips with `q = crrUpProb u d r` is an equivalent
martingale measure, in the sense of `FTAPDiscrete.IsEMM`, for the discounted spot, against the
real-world law of i.i.d. `Bernoulli(p)` flips, any `0 < p < 1`: the martingale property
`martingale_discountedSpot` transports along `flips T`. -/
theorem isEMM_horizonSpot (h : BinomialNoArb u d r) (S₀ : ℝ) {p q : ℝ≥0} (hp0 : 0 < p)
    (hp1 : p < 1) (hq1 : q ≤ 1) (hqcrr : crrUpProb u d r = q) :
    IsEMM (horizonFiltration T) (horizonMeasure T p hp1.le) (horizonSpot T S₀ u d r) T
      (horizonMeasure T q hq1) := by
  have hq0 : 0 < q := by
    have := (crrUpProb_mem_Ioo h).1
    rw [hqcrr] at this
    exact_mod_cast this
  have hq1' : q < 1 := by
    have := (crrUpProb_mem_Ioo h).2
    rw [hqcrr] at this
    exact_mod_cast this
  refine ⟨⟨inferInstance, absolutelyContinuous_of_pos (horizonMeasure_pos T hp0 hp1),
    absolutelyContinuous_of_pos (horizonMeasure_pos T hq0 hq1')⟩, fun t ht ↦ ?_⟩
  refine ae_eq_condExp_of_forall_setIntegral_eq ((horizonFiltration T).le t) Integrable.of_finite
    (fun s _ _ ↦ Integrable.of_finite.integrableOn) (fun s hs _ ↦ ?_)
    (stronglyAdapted_horizonSpot t).aestronglyMeasurable
  have hs' : MeasurableSet[flipFiltration t] (flips T ⁻¹' s) := by
    rw [← comap_flips_horizonFiltration T ht.le]
    exact ⟨s, hs, rfl⟩
  have hsm : MeasurableSet s := (horizonFiltration T).le t s hs
  rw [horizonMeasure, setIntegral_map hsm Integrable.of_finite.aestronglyMeasurable
      (measurable_flips T).aemeasurable,
    setIntegral_map hsm Integrable.of_finite.aestronglyMeasurable (measurable_flips T).aemeasurable]
  simp_rw [horizonSpot_flips ht.le, horizonSpot_flips (Nat.succ_le_of_lt ht)]
  exact (martingale_discountedSpot h S₀ hq1 hqcrr).setIntegral_eq (Nat.le_succ t) hs'

/-- **Multi-period binomial no-arbitrage, through the discrete FTAP.** Under
`BinomialNoArb u d r`, the `T`-period CRR market (discounted spot, flip filtration, real-world
law of i.i.d. `Bernoulli(p)` flips, `0 < p < 1`) admits no arbitrage: `isEMM_horizonSpot` and
the easy direction of `ftap_discrete`. -/
theorem noArbitrage_horizonSpot (h : BinomialNoArb u d r) (S₀ : ℝ) {p : ℝ≥0} (hp0 : 0 < p)
    (hp1 : p < 1) :
    NoArbitrage (horizonFiltration T) (horizonMeasure T p hp1.le) (horizonSpot T S₀ u d r) T := by
  obtain ⟨q, hq1, hqcrr⟩ : ∃ q : ℝ≥0, q ≤ 1 ∧ crrUpProb u d r = q :=
    ⟨(crrUpProb u d r).toNNReal, Real.toNNReal_le_one.2 (crrUpProb_mem_Ioo h).2.le,
      (Real.coe_toNNReal _ (crrUpProb_mem_Ioo h).1.le).symm⟩
  exact (ftap_discrete _ _ _ _ stronglyAdapted_horizonSpot (horizonMeasure_pos T hp0 hp1)).2
    ⟨_, isEMM_horizonSpot h S₀ hp0 hp1 hq1 hqcrr⟩

lemma horizonSpot_zero (x : Fin T → Bool) : horizonSpot T S₀ u d r 0 x = S₀ := by
  simp [horizonSpot, discountedSpot, spotPath]

lemma horizonSpot_one (hT : 0 < T) (x : Fin T → Bool) :
    horizonSpot T S₀ u d r 1 x = Real.exp (-r) * (S₀ * if x ⟨0, hT⟩ then u else d) := by
  simp [horizonSpot, discountedSpot, spotPath, padFlips, hT, min_eq_left (Nat.succ_le_of_lt hT)]

/-- Holding `c` units over the first period only has gain `c · (S₁ − S₀)`. -/
lemma martingaleTransform_holdFirst (c : ℝ) (hT : 0 < T) (x : Fin T → Bool) :
    martingaleTransform (fun s _ ↦ if s = 1 then c else 0) (horizonSpot T S₀ u d r) T x
      = c * (horizonSpot T S₀ u d r 1 x - horizonSpot T S₀ u d r 0 x) := by
  rw [martingaleTransform, Finset.sum_eq_single 0]
  · simp [mul_comm]
  · intro k _ hk
    simp [hk]
  · intro h0
    exact absurd (Finset.mem_range.2 hT) h0

/-- **A one-period arbitrage if the tree is not arbitrage-free.** For `S₀ > 0`, `0 < d < u` and at
least one period, no arbitrage in the `T`-period market forces `d < e^r < u`: if `e^r ≤ d`, holding
one unit over the first period is a sure gain, and if `u ≤ e^r`, so is holding minus one. -/
theorem binomialNoArb_of_noArbitrage (hS₀ : 0 < S₀) (hd : 0 < d) (hdu : d < u) (hT : 0 < T)
    {p : ℝ≥0} (hp0 : 0 < p) (hp1 : p < 1)
    (hNA : NoArbitrage (horizonFiltration T) (horizonMeasure T p hp1.le)
      (horizonSpot T S₀ u d r) T) :
    BinomialNoArb u d r := by
  have hpos := horizonMeasure_pos T hp0 hp1
  have he : Real.exp (-r) * Real.exp r = 1 := by rw [← Real.exp_add]; simp
  have hden : 0 < S₀ * Real.exp (-r) := mul_pos hS₀ (Real.exp_pos _)
  -- the first-period excess gain, node by node
  have hgain (x : Fin T → Bool) : horizonSpot T S₀ u d r 1 x - horizonSpot T S₀ u d r 0 x
      = S₀ * Real.exp (-r) * ((if x ⟨0, hT⟩ then u else d) - Real.exp r) := by
    rw [horizonSpot_one hT, horizonSpot_zero]
    linear_combination S₀ * he
  -- a sure first-period gain is no gain at all
  have noarb (c : ℝ) (hnn : ∀ x : Fin T → Bool,
      0 ≤ c * (S₀ * Real.exp (-r) * ((if x ⟨0, hT⟩ then u else d) - Real.exp r)))
      (x : Fin T → Bool) :
      c * (S₀ * Real.exp (-r) * ((if x ⟨0, hT⟩ then u else d) - Real.exp r)) = 0 := by
    have h := hNA (fun s _ ↦ if s = 1 then c else 0) (fun _ ↦ stronglyMeasurable_const)
      (Filter.Eventually.of_forall fun x ↦ by
        simpa only [Pi.zero_apply, martingaleTransform_holdFirst c hT, hgain] using hnn x)
    simpa only [Pi.zero_apply, martingaleTransform_holdFirst c hT, hgain] using
      eq_of_ae_eq_of_pos hpos h x
  refine ⟨hd, ?_, ?_⟩
  · by_contra hle
    have hle := not_lt.1 hle
    have := noarb 1 (fun x ↦ by
      split_ifs <;> exact mul_nonneg (by norm_num) (mul_nonneg hden.le (by linarith))) fun _ ↦ true
    beta_reduce at this
    rw [if_pos rfl, one_mul] at this
    exact (mul_pos hden (by linarith)).ne' this
  · by_contra hle
    have hle := not_lt.1 hle
    have := noarb (-1) (fun x ↦ by
      split_ifs <;> exact (by nlinarith [mul_nonneg hden.le (sub_nonneg.2 hle)])) fun _ ↦ false
    beta_reduce at this
    rw [if_neg (by decide)] at this
    nlinarith [mul_pos hden (show 0 < Real.exp r - d by linarith)]

/-- **No arbitrage in the multi-period binomial tree iff `d < e^r < u`.** For `S₀ > 0`,
`0 < d < u`, at least one period and a real-world law of i.i.d. `Bernoulli(p)` flips, `0 < p < 1`,
the `T`-period CRR market has no arbitrage (`FTAPDiscrete.NoArbitrage`) exactly when
`BinomialNoArb u d r` holds. -/
theorem noArbitrage_horizonSpot_iff (hS₀ : 0 < S₀) (hd : 0 < d) (hdu : d < u) (hT : 0 < T)
    {p : ℝ≥0} (hp0 : 0 < p) (hp1 : p < 1) :
    NoArbitrage (horizonFiltration T) (horizonMeasure T p hp1.le) (horizonSpot T S₀ u d r) T
      ↔ BinomialNoArb u d r :=
  ⟨binomialNoArb_of_noArbitrage hS₀ hd hdu hT hp0 hp1, fun h ↦ noArbitrage_horizonSpot h S₀ hp0 hp1⟩

end NoArbitrage

section Uniqueness

variable {T : ℕ} {S₀ u d r : ℝ}

/-- One period of the market price: `S_{t+1} = S_t · e^{-r} · (u or d)` according to flip `t`. -/
lemma horizonSpot_succ {t : ℕ} (ht : t < T) (y : Fin T → Bool) :
    horizonSpot T S₀ u d r (t + 1) y
      = horizonSpot T S₀ u d r t y * (Real.exp (-r) * if y ⟨t, ht⟩ then u else d) := by
  have h1 : min (t + 1) T = t + 1 := min_eq_left ht
  have h2 : min t T = t := min_eq_left ht.le
  simp only [horizonSpot, discountedSpot, spotPath, h1, h2, Finset.prod_range_succ,
    padFlips, dif_pos ht]
  rw [show -(r * ((t + 1 : ℕ) : ℝ)) = -(r * t) + -r by push_cast; ring, Real.exp_add]
  ring

lemma horizonSpot_pos (hS₀ : 0 < S₀) (hd : 0 < d) (hu : 0 < u) (n : ℕ) (y : Fin T → Bool) :
    0 < horizonSpot T S₀ u d r n y := by
  unfold horizonSpot discountedSpot spotPath
  refine mul_pos (Real.exp_pos _) (mul_pos hS₀ (Finset.prod_pos fun i _ ↦ ?_))
  split_ifs <;> assumption

/-- The **atom of `ℱₜ` through `x`**: the paths that agree with `x` on the first `t` flips. -/
def horizonAtom (T t : ℕ) (x : Fin T → Bool) : Set (Fin T → Bool) :=
  revealed T t ⁻¹' {revealed T t x}

lemma measurableSet_horizonAtom (t : ℕ) (x : Fin T → Bool) :
    MeasurableSet[horizonFiltration T t] (horizonAtom T t x) :=
  ⟨{revealed T t x}, measurableSet_singleton _, rfl⟩

lemma mem_horizonAtom {t : ℕ} {x y : Fin T → Bool} :
    y ∈ horizonAtom T t x ↔ ∀ i : Fin T, (i : ℕ) < t → y i = x i := by
  simp only [horizonAtom, Set.mem_preimage, Set.mem_singleton_iff, revealed, funext_iff]
  refine forall_congr' fun i ↦ ?_
  by_cases h : (i : ℕ) < t <;> simp [h]

lemma horizonAtom_zero (x : Fin T → Bool) : horizonAtom T 0 x = Set.univ :=
  Set.eq_univ_of_forall fun _ ↦ mem_horizonAtom.2 fun _ hi ↦ absurd hi (Nat.not_lt_zero _)

lemma horizonAtom_horizon (x : Fin T → Bool) : horizonAtom T T x = {x} :=
  Set.ext fun y ↦ by simp [mem_horizonAtom, funext_iff]

lemma horizonAtom_succ {t : ℕ} (ht : t < T) (x : Fin T → Bool) :
    horizonAtom T (t + 1) x = horizonAtom T t x ∩ {y | y ⟨t, ht⟩ = x ⟨t, ht⟩} := by
  ext y
  simp only [mem_horizonAtom, Set.mem_inter_iff, Set.mem_ofPred_eq]
  refine ⟨fun h ↦ ⟨fun i hi ↦ h i (by omega), h _ (Nat.lt_succ_self t)⟩, fun ⟨h, h'⟩ i hi ↦ ?_⟩
  rcases Nat.lt_succ_iff_lt_or_eq.1 hi with hi | hi
  · exact h i hi
  · have : i = ⟨t, ht⟩ := Fin.ext hi
    rw [this]; exact h'

lemma horizonSpot_eq_of_mem_horizonAtom {t : ℕ} {x y : Fin T → Bool} (hy : y ∈ horizonAtom T t x) :
    horizonSpot T S₀ u d r t y = horizonSpot T S₀ u d r t x := by
  rw [← horizonSpot_revealed t y, ← horizonSpot_revealed t x]
  exact congrArg _ hy

variable {P Q : Measure (Fin T → Bool)}

/-- **The conditional up-probability of an equivalent martingale measure is `crrUpProb`.** If
`Q` makes the discounted spot a martingale, then `Q` gives the up-flip at time `t` probability
`crrUpProb` *conditionally on every history atom* of `ℱₜ`: the martingale property in set-integral
form on the atom `A`, `∫_A (S_{t+1} − S_t) dQ = 0`, reads
`S_t(x) · (e^{-r}(u · Q(A ∩ up) + d · Q(A ∩ down)) − Q(A)) = 0`, which together with
`Q(A) = Q(A ∩ up) + Q(A ∩ down)` pins `Q(A ∩ up)/Q(A)` to `(e^r − d)/(u − d)`. -/
theorem IsEMM.real_atom_up (hS₀ : 0 < S₀) (h : BinomialNoArb u d r)
    (hQ : IsEMM (horizonFiltration T) P (horizonSpot T S₀ u d r) T Q) {t : ℕ} (ht : t < T)
    (x : Fin T → Bool) :
    Q.real (horizonAtom T t x ∩ {y | y ⟨t, ht⟩ = true})
      = crrUpProb u d r * Q.real (horizonAtom T t x) := by
  haveI := hQ.isProb
  set A := horizonAtom T t x
  set U : Set (Fin T → Bool) := {y | y ⟨t, ht⟩ = true}
  have hA : MeasurableSet A := (horizonFiltration T).le t _ (measurableSet_horizonAtom t x)
  have hU : MeasurableSet U := MeasurableSet.of_discrete
  have hspot : ∫ y in A, horizonSpot T S₀ u d r (t + 1) y ∂Q
      = ∫ y in A, horizonSpot T S₀ u d r t y ∂Q := by
    rw [← setIntegral_condExp ((horizonFiltration T).le t) Integrable.of_finite
      (measurableSet_horizonAtom t x)]
    exact setIntegral_congr_ae hA (by filter_upwards [hQ.mart t ht] with y hy _ using hy.symm)
  set s := horizonSpot T S₀ u d r t x
  have hs : 0 < s := horizonSpot_pos hS₀ h.d_pos (h.d_pos.trans h.d_lt_u) t x
  -- split the atom along the next flip
  have hsplit (F : (Fin T → Bool) → ℝ) : ∫ y in A, F y ∂Q
      = ∫ y in A ∩ U, F y ∂Q + ∫ y in A \ U, F y ∂Q :=
    (integral_inter_add_sdiff hU Integrable.of_finite.integrableOn).symm
  -- on each half the increment is a constant multiple of `s`
  have hup : ∫ y in A ∩ U, horizonSpot T S₀ u d r (t + 1) y ∂Q
      = Q.real (A ∩ U) * (s * (Real.exp (-r) * u)) := by
    rw [setIntegral_congr_fun (hA.inter hU) fun y hy ↦ by
      rw [horizonSpot_succ ht, horizonSpot_eq_of_mem_horizonAtom hy.1, if_pos (show y ⟨t, ht⟩ = true from hy.2)],
      setIntegral_const, smul_eq_mul]
  have hdown : ∫ y in A \ U, horizonSpot T S₀ u d r (t + 1) y ∂Q
      = Q.real (A \ U) * (s * (Real.exp (-r) * d)) := by
    rw [setIntegral_congr_fun (hA.diff hU) fun y hy ↦ by
      rw [horizonSpot_succ ht, horizonSpot_eq_of_mem_horizonAtom hy.1,
        if_neg (show ¬ y ⟨t, ht⟩ = true from hy.2)],
      setIntegral_const, smul_eq_mul]
  have hnow : ∫ y in A, horizonSpot T S₀ u d r t y ∂Q = Q.real A * s := by
    rw [setIntegral_congr_fun hA fun y hy ↦ horizonSpot_eq_of_mem_horizonAtom hy,
      setIntegral_const, smul_eq_mul]
  rw [hsplit, hup, hdown, hnow, ← measureReal_inter_add_sdiff (s := A) hU] at hspot
  have he : Real.exp (-r) * Real.exp r = 1 := by rw [← Real.exp_add]; simp
  have hud : u - d ≠ 0 := (sub_pos.2 h.d_lt_u).ne'
  have key : (Real.exp (-r) * u - 1) * Q.real (A ∩ U) + (Real.exp (-r) * d - 1) * Q.real (A \ U)
      = 0 := by
    refine mul_left_cancel₀ hs.ne' ?_
    linear_combination hspot
  rw [crrUpProb, div_mul_eq_mul_div, eq_div_iff hud, ← measureReal_inter_add_sdiff (s := A) hU]
  linear_combination Real.exp r * key - (u * Q.real (A ∩ U) + d * Q.real (A \ U)) * he

/-- The conditional probability of either flip at time `t`, given a history atom: `crrUpProb` for
up and `1 - crrUpProb` for down. -/
theorem IsEMM.real_atom_flip (hS₀ : 0 < S₀) (h : BinomialNoArb u d r)
    (hQ : IsEMM (horizonFiltration T) P (horizonSpot T S₀ u d r) T Q) {t : ℕ} (ht : t < T)
    (x : Fin T → Bool) (b : Bool) :
    Q.real (horizonAtom T t x ∩ {y | y ⟨t, ht⟩ = b})
      = (if b then crrUpProb u d r else 1 - crrUpProb u d r) * Q.real (horizonAtom T t x) := by
  have hup := IsEMM.real_atom_up hS₀ h hQ ht x
  cases b
  · haveI := hQ.isProb
    have hU : MeasurableSet {y : Fin T → Bool | y ⟨t, ht⟩ = true} := MeasurableSet.of_discrete
    have hsum := measureReal_inter_add_sdiff (μ := Q) (s := horizonAtom T t x) hU
    have hset : horizonAtom T t x ∩ {y | y ⟨t, ht⟩ = false}
        = horizonAtom T t x \ {y | y ⟨t, ht⟩ = true} := by
      ext y; simp
    rw [hset, if_neg Bool.false_ne_true]
    linear_combination hsum - hup
  · simpa using hup

/-- **Every history atom has the product-form probability.** Under an equivalent martingale
measure `Q`, the paths agreeing with `x` on the first `t ≤ T` flips have probability
`∏_{i<t} (q if xᵢ else 1 − q)`, `q = crrUpProb u d r`: induction on `t`, each period multiplying by
the conditional probability of the flip (`IsEMM.real_atom_flip`). -/
theorem IsEMM.real_horizonAtom (hS₀ : 0 < S₀) (h : BinomialNoArb u d r)
    (hQ : IsEMM (horizonFiltration T) P (horizonSpot T S₀ u d r) T Q) (x : Fin T → Bool) :
    ∀ t ≤ T, Q.real (horizonAtom T t x)
      = ∏ i : Fin T, if (i : ℕ) < t then (if x i then crrUpProb u d r else 1 - crrUpProb u d r)
          else 1 := by
  intro t
  induction t with
  | zero =>
    haveI := hQ.isProb
    intro _
    simp [horizonAtom_zero]
  | succ t ih =>
    intro ht
    have ht' : t < T := ht
    rw [horizonAtom_succ ht', IsEMM.real_atom_flip hS₀ h hQ ht' x (x ⟨t, ht'⟩), ih ht'.le, mul_comm]
    have hpt (i : Fin T) : (if (i : ℕ) < t + 1 then
          (if x i then crrUpProb u d r else 1 - crrUpProb u d r) else 1)
        = (if (i : ℕ) < t then (if x i then crrUpProb u d r else 1 - crrUpProb u d r) else 1)
          * (if i = ⟨t, ht'⟩ then (if x i then crrUpProb u d r else 1 - crrUpProb u d r) else 1) := by
      by_cases h1 : (i : ℕ) < t
      · have : i ≠ ⟨t, ht'⟩ := fun e ↦ by simp [e] at h1
        simp [h1, this, show (i : ℕ) < t + 1 by omega]
      · by_cases h2 : i = ⟨t, ht'⟩
        · subst h2; simp
        · have : ¬ (i : ℕ) < t + 1 := by
            have := Fin.val_ne_of_ne h2
            simp only at this
            omega
          simp [h1, h2, this]
    rw [Finset.prod_congr rfl fun i _ ↦ hpt i, Finset.prod_mul_distrib, Finset.prod_ite_eq']
    simp

lemma horizonMeasure_real_singleton (q : ℝ≥0) (hq : q ≤ 1) (x : Fin T → Bool) :
    (horizonMeasure T q hq).real {x} = ∏ i, if x i then (q : ℝ) else 1 - q := by
  rw [measureReal_def, horizonMeasure_singleton, ENNReal.toReal_prod]
  refine Finset.prod_congr rfl fun i _ ↦ ?_
  cases x i with
  | false =>
    simp only [Bool.false_eq_true, ↓reduceIte]
    rw [ENNReal.toReal_sub_of_le (ENNReal.coe_le_one_iff.mpr hq) ENNReal.one_ne_top]
    simp
  | true => simp

/-- **The equivalent martingale measure of the multi-period tree is unique.** Under
`BinomialNoArb u d r` and `S₀ > 0`, every probability measure `Q` that makes the discounted spot
a martingale for the filtration of the first `n` flips (`IsEMM`, for any reference measure `P`)
is the law of `T` i.i.d. `Bernoulli(q)` flips with `q = crrUpProb u d r`. Node by node,
`Q` gives the next flip conditional probability `q` on every history atom
(`IsEMM.real_atom_flip`), so it gives each path the product probability
(`IsEMM.real_horizonAtom` at `t = T`), which is `horizonMeasure_singleton`. -/
theorem IsEMM.eq_horizonMeasure (hS₀ : 0 < S₀) (h : BinomialNoArb u d r)
    (hQ : IsEMM (horizonFiltration T) P (horizonSpot T S₀ u d r) T Q) {q : ℝ≥0} (hq1 : q ≤ 1)
    (hqcrr : crrUpProb u d r = q) : Q = horizonMeasure T q hq1 := by
  haveI := hQ.isProb
  refine Measure.ext_iff_singleton.2 fun x ↦ ?_
  refine (ENNReal.toReal_eq_toReal_iff' (measure_ne_top _ _) (measure_ne_top _ _)).1 ?_
  change Q.real {x} = (horizonMeasure T q hq1).real {x}
  rw [horizonMeasure_real_singleton, ← horizonAtom_horizon,
    hQ.real_horizonAtom hS₀ h x T le_rfl]
  refine Finset.prod_congr rfl fun i _ ↦ ?_
  simp [i.2, hqcrr]

/-- **The multi-period binomial market has a unique equivalent martingale measure.** Under
`BinomialNoArb u d r` and `S₀ > 0`, for every real-world law of i.i.d. `Bernoulli(p)` flips,
`0 < p < 1`, the `T`-period CRR market has exactly one `FTAPDiscrete.IsEMM`, the i.i.d.
`Bernoulli(crrUpProb u d r)` law of the flips: existence is `isEMM_horizonSpot` and uniqueness
`IsEMM.eq_horizonMeasure`. Uniqueness of the equivalent martingale measure is what the second
fundamental theorem equates with completeness; replication of claims is not stated here. -/
theorem existsUnique_isEMM_horizonSpot (hS₀ : 0 < S₀) (h : BinomialNoArb u d r) {p q : ℝ≥0}
    (hp0 : 0 < p) (hp1 : p < 1) (hq1 : q ≤ 1) (hqcrr : crrUpProb u d r = q) :
    ∃! Q, IsEMM (horizonFiltration T) (horizonMeasure T p hp1.le) (horizonSpot T S₀ u d r) T Q :=
  ⟨horizonMeasure T q hq1, isEMM_horizonSpot h S₀ hp0 hp1 hq1 hqcrr,
    fun _ hQ ↦ hQ.eq_horizonMeasure hS₀ h hq1 hqcrr⟩

end Uniqueness

