module

public import MathFin.Pricing.FTAP.NoArbitrageLocal

/-!
# The Dalang–Morton–Willinger theorem for one asset

The fundamental theorem of asset pricing for one real-valued asset on a general filtered
probability space and a finite horizon, with no integrability, no finiteness of the space and no
measurable-selection hypothesis: an adapted price `S` has no arbitrage up to the horizon `N` if
and only if some probability measure `Q` equivalent to `P` makes `S` a martingale.

The proof follows the one-asset argument (Föllmer–Schied §5.2, Kabanov–Stricker for `d` assets)
and avoids the conditional one-period theorem of `DalangMortonWillinger.lean`, which is stronger
than the theorem needs and can fail: with `𝓕 0` generated by a uniform `u`, and `ΔS = ±1` with
`P (ΔS = 1 | u) = u`, every `Z` with `E[Z | 𝓕 0] = 1` and `E[Z ΔS | 𝓕 0] = 0` equals `1 / (2u)` on
`{ΔS = 1}`, which is unbounded. What is true is that the one-period densities exist unnormalised.

1. **Integrability** (`exists_integrable_equivalent`): reweighing `P` by `exp (-∑ ‖S n‖)` gives an
   equivalent finite measure under which every `S n` is integrable.
2. **One period** (`exists_weight_of_noArbitrage`): for an arbitrage-free integrable gain `X`
   there is a weight `Z ∈ (0, 1]` with `E[Z X | m] = 0`, namely
   `E[X⁻ | m] / (E[X⁺ | m] + E[X⁻ | m])` on `{X > 0}` and
   `E[X⁺ | m] / (E[X⁺ | m] + E[X⁻ | m])` on `{X < 0}`.
3. **Backward induction** (`exists_measure_fair_increments`): under the measure already weighted
   by the later periods the next weight is built, and the weights compose because `Z t` is
   `𝓕 (t+1)`-measurable and bounded. The weights are not normalised period by period.
4. **Normalisation** (`OneAsset.exists_isEMM_of_noArbitrage`): the total mass is normalised once,
   at the end.

The several-asset case (`F = EuclideanSpace ℝ (Fin d)`, `d > 1`) is not covered: there the
conditional one-period step needs a measurable selection of the one-period martingale measure
(Dalang–Morton–Willinger; Rogers 1994; Kabanov–Stricker 2001), and remains open in this library.

## Main results

* `exists_weight_of_noArbitrage`: the weight of one arbitrage-free period.
* `exists_measure_fair_increments`: backward induction on the horizon.
* `OneAsset.exists_isEMM_of_noArbitrage`: no arbitrage gives an equivalent martingale measure.
* `OneAsset.noArbitrage_iff_exists_isEMM`: the equivalence, with `IsEMM.noArbitrage`.

## References

* [H. Föllmer and A. Schied, *Stochastic Finance: An Introduction in Discrete Time*][FollmerSchied],
  §5.2

## Tags

fundamental theorem of asset pricing, Dalang–Morton–Willinger, equivalent martingale measure,
no arbitrage, general probability space, one asset, JEL G13, MSC 91G20, MSC 60G42
-/

@[expose] public section

namespace MathFin

open MeasureTheory
open scoped ENNReal

section OnePeriod

variable {Ω : Type*} {m m₁ m0 : MeasurableSpace Ω} {μ : Measure Ω} {X : Ω → ℝ}

/-- **Pulling a bounded `m`-measurable factor through a conditional expectation under the
integral**: `∫ f h = ∫ f μ[h|m]`. -/
theorem integral_mul_condExp (hm : m ≤ m0) [SigmaFinite (μ.trim hm)] {f h : Ω → ℝ}
    (hf : StronglyMeasurable[m] f) (hfh : Integrable (f * h) μ) (hh : Integrable h μ) :
    ∫ ω, f ω * h ω ∂μ = ∫ ω, f ω * (μ[h | m]) ω ∂μ :=
  (integral_condExp hm).symm.trans
    (integral_congr_ae (condExp_mul_of_stronglyMeasurable_left hf hfh hh))

/-- **No arbitrage moves the negative part's mass onto the positive part's**: if the one-period
gain `X` is arbitrage free over `m` and its negative part has no mass on the `m`-set `A`, neither
has its positive part. -/
theorem setIntegral_posPart_eq_zero (hm : m ≤ m0) (hX : Integrable X μ)
    (hNA : ∀ θ : Ω → ℝ, StronglyMeasurable[m] θ → 0 ≤ᵐ[μ] (fun ω ↦ θ ω * X ω) →
      (fun ω ↦ θ ω * X ω) =ᵐ[μ] 0)
    {A : Set Ω} (hA : MeasurableSet[m] A) (h : ∫ ω in A, max (-X ω) 0 ∂μ = 0) :
    ∫ ω in A, max (X ω) 0 ∂μ = 0 := by
  have hneg : ∀ᵐ ω ∂μ, ω ∈ A → max (-X ω) 0 = 0 :=
    (ae_restrict_iff' (hm A hA)).1
      ((setIntegral_eq_zero_iff_of_nonneg_ae (ae_of_all _ fun ω ↦ le_max_right _ _)
        hX.neg.pos_part.integrableOn).1 h)
  have hgain : 0 ≤ᵐ[μ] fun ω ↦ A.indicator (fun _ ↦ (1 : ℝ)) ω * X ω := by
    filter_upwards [hneg] with ω hω
    by_cases hωA : ω ∈ A
    · simpa [hωA] using max_eq_right_iff.1 (hω hωA)
    · simp [hωA]
  have h0 := hNA _ (stronglyMeasurable_const.indicator hA) hgain
  refine setIntegral_eq_zero_of_ae_eq_zero ?_
  filter_upwards [h0] with ω hω hωA
  have : X ω = 0 := by simpa [hωA] using hω
  simp [this]

/-- **A conditionally balancing weight for an arbitrage-free one-period gain.** If `X` is a
`μ`-integrable `m₁`-measurable gain that is arbitrage free over `m ≤ m₁`, some `m₁`-measurable
weight `Z`, valued in `(0, 1]` almost everywhere, makes `X` fair against every bounded
`m`-measurable position: `∫ g Z X dμ = 0`. The weight is *not* normalised (`μ[Z | m] = 1` is not
asked, and can fail with `Z` bounded: it is a density that may be unbounded). It is the ratio
`E[X⁻ | m] / (E[X⁺ | m] + E[X⁻ | m])` on `{X > 0}` and `E[X⁺ | m] / (E[X⁺ | m] + E[X⁻ | m])` on
`{X < 0}`; no arbitrage makes the two conditional means vanish together. -/
theorem exists_weight_of_noArbitrage [IsFiniteMeasure μ] (hm : m ≤ m₁) (hm₁ : m₁ ≤ m0)
    (hXm : StronglyMeasurable[m₁] X) (hX : Integrable X μ)
    (hNA : ∀ θ : Ω → ℝ, StronglyMeasurable[m] θ → 0 ≤ᵐ[μ] (fun ω ↦ θ ω * X ω) →
      (fun ω ↦ θ ω * X ω) =ᵐ[μ] 0) :
    ∃ Z : Ω → ℝ, StronglyMeasurable[m₁] Z ∧ (∀ ω, 0 ≤ Z ω ∧ Z ω ≤ 1) ∧ (∀ᵐ ω ∂μ, 0 < Z ω) ∧
      ∀ g : Ω → ℝ, StronglyMeasurable[m] g → (∃ K, ∀ ω, |g ω| ≤ K) →
        ∫ ω, g ω * (Z ω * X ω) ∂μ = 0 := by
  classical
  have hm0 : m ≤ m0 := hm.trans hm₁
  have hXp : Integrable (fun ω ↦ max (X ω) 0) μ := hX.pos_part
  have hXn : Integrable (fun ω ↦ max (-X ω) 0) μ := hX.neg.pos_part
  -- the nonnegative conditional means of the positive and negative parts
  obtain ⟨a, ha⟩ : ∃ a : Ω → ℝ, a = fun ω ↦ max ((μ[fun ω ↦ max (X ω) 0 | m]) ω) 0 := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : Ω → ℝ, b = fun ω ↦ max ((μ[fun ω ↦ max (-X ω) 0 | m]) ω) 0 := ⟨_, rfl⟩
  have ha_m : StronglyMeasurable[m] a := by
    rw [ha]
    let _ := m
    exact stronglyMeasurable_condExp.sup stronglyMeasurable_const
  have hb_m : StronglyMeasurable[m] b := by
    rw [hb]
    let _ := m
    exact stronglyMeasurable_condExp.sup stronglyMeasurable_const
  have ha0 : ∀ ω, 0 ≤ a ω := fun ω ↦ ha ▸ le_max_right _ _
  have hb0 : ∀ ω, 0 ≤ b ω := fun ω ↦ hb ▸ le_max_right _ _
  have ha_ae : a =ᵐ[μ] μ[fun ω ↦ max (X ω) 0 | m] :=
    (condExp_nonneg (ae_of_all μ fun ω ↦ le_max_right (X ω) 0)).mono fun ω h ↦ by
      rw [ha]; exact max_eq_left h
  have hb_ae : b =ᵐ[μ] μ[fun ω ↦ max (-X ω) 0 | m] :=
    (condExp_nonneg (ae_of_all μ fun ω ↦ le_max_right (-X ω) 0)).mono fun ω h ↦ by
      rw [hb]; exact max_eq_left h
  have ha_int : Integrable a μ := integrable_condExp.congr ha_ae.symm
  have hb_int : Integrable b μ := integrable_condExp.congr hb_ae.symm
  have hsetA (A : Set Ω) (hA : MeasurableSet[m] A) :
      ∫ ω in A, a ω ∂μ = ∫ ω in A, max (X ω) 0 ∂μ :=
    (setIntegral_congr_ae (hm0 A hA) (ha_ae.mono fun ω h _ ↦ h)).trans
      (setIntegral_condExp hm0 hXp hA)
  have hsetB (A : Set Ω) (hA : MeasurableSet[m] A) :
      ∫ ω in A, b ω ∂μ = ∫ ω in A, max (-X ω) 0 ∂μ :=
    (setIntegral_congr_ae (hm0 A hA) (hb_ae.mono fun ω h _ ↦ h)).trans
      (setIntegral_condExp hm0 hXn hA)
  -- no arbitrage: the two conditional means vanish together
  have hNA' : ∀ θ : Ω → ℝ, StronglyMeasurable[m] θ → 0 ≤ᵐ[μ] (fun ω ↦ θ ω * (-X) ω) →
      (fun ω ↦ θ ω * (-X) ω) =ᵐ[μ] 0 := fun θ hθ hpos ↦ by
    have := hNA (-θ) hθ.neg (by simpa using hpos)
    simpa using this
  have hba : ∀ A, MeasurableSet[m] A → ∫ ω in A, b ω ∂μ = 0 → ∫ ω in A, a ω ∂μ = 0 :=
    fun A hA h ↦ (hsetA A hA).trans
      (setIntegral_posPart_eq_zero hm0 hX hNA hA ((hsetB A hA).symm.trans h))
  have hab : ∀ A, MeasurableSet[m] A → ∫ ω in A, a ω ∂μ = 0 → ∫ ω in A, b ω ∂μ = 0 :=
    fun A hA h ↦ (hsetB A hA).trans (by
      simpa using setIntegral_posPart_eq_zero hm0 hX.neg hNA' hA (by
        simpa using (hsetA A hA).symm.trans h))
  have vanish (f g : Ω → ℝ) (hf0 : ∀ ω, 0 ≤ f ω) (hfi : Integrable f μ)
      (hg : StronglyMeasurable[m] g)
      (himp : ∀ A, MeasurableSet[m] A → ∫ ω in A, g ω ∂μ = 0 → ∫ ω in A, f ω ∂μ = 0) :
      ∀ᵐ ω ∂μ, g ω = 0 → f ω = 0 := by
    have hA : MeasurableSet[m] {ω | g ω = 0} := hg.measurable (measurableSet_singleton 0)
    have h0 := himp _ hA (setIntegral_eq_zero_of_forall_eq_zero fun ω hω ↦ hω)
    exact (ae_restrict_iff' (hm0 _ hA)).1
      ((setIntegral_eq_zero_iff_of_nonneg_ae (ae_of_all _ hf0) hfi.integrableOn).1 h0)
  have hboth : ∀ᵐ ω ∂μ, 0 < a ω ↔ 0 < b ω := by
    filter_upwards [vanish a b ha0 ha_int hb_m hba, vanish b a hb0 hb_int ha_m hab] with ω h1 h2
    exact ⟨fun h ↦ lt_of_le_of_ne (hb0 ω) fun h' ↦ h.ne' (h1 h'.symm),
      fun h ↦ lt_of_le_of_ne (ha0 ω) fun h' ↦ h.ne' (h2 h'.symm)⟩
  -- the weight
  obtain ⟨u, hu⟩ : ∃ u : Ω → ℝ, u = fun ω ↦ if a ω + b ω = 0 then 1 else b ω / (a ω + b ω) :=
    ⟨_, rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : Ω → ℝ, w = fun ω ↦ if a ω + b ω = 0 then 1 else a ω / (a ω + b ω) :=
    ⟨_, rfl⟩
  have hs_m : StronglyMeasurable[m] fun ω ↦ a ω + b ω := ha_m.add hb_m
  have hu_m : StronglyMeasurable[m] u := hu ▸ StronglyMeasurable.ite
    (hs_m.measurable (measurableSet_singleton 0)) stronglyMeasurable_const (hb_m.div hs_m)
  have hw_m : StronglyMeasurable[m] w := hw ▸ StronglyMeasurable.ite
    (hs_m.measurable (measurableSet_singleton 0)) stronglyMeasurable_const (ha_m.div hs_m)
  have hu01 : ∀ ω, 0 ≤ u ω ∧ u ω ≤ 1 := fun ω ↦ by
    rw [hu]
    dsimp only
    split_ifs with h
    · exact ⟨zero_le_one, le_rfl⟩
    · have hs : 0 < a ω + b ω := lt_of_le_of_ne (add_nonneg (ha0 ω) (hb0 ω)) (Ne.symm h)
      exact ⟨div_nonneg (hb0 ω) hs.le, (div_le_one hs).2 (by linarith [ha0 ω])⟩
  have hw01 : ∀ ω, 0 ≤ w ω ∧ w ω ≤ 1 := fun ω ↦ by
    rw [hw]
    dsimp only
    split_ifs with h
    · exact ⟨zero_le_one, le_rfl⟩
    · have hs : 0 < a ω + b ω := lt_of_le_of_ne (add_nonneg (ha0 ω) (hb0 ω)) (Ne.symm h)
      exact ⟨div_nonneg (ha0 ω) hs.le, (div_le_one hs).2 (by linarith [hb0 ω])⟩
  obtain ⟨Z, hZ⟩ : ∃ Z : Ω → ℝ,
      Z = fun ω ↦ if 0 < X ω then u ω else if X ω < 0 then w ω else 1 := ⟨_, rfl⟩
  have hZ_m : StronglyMeasurable[m₁] Z := hZ ▸ StronglyMeasurable.ite
    (hXm.measurable measurableSet_Ioi) (hu_m.mono hm)
    (StronglyMeasurable.ite (hXm.measurable measurableSet_Iio) (hw_m.mono hm)
      stronglyMeasurable_const)
  have hZ01 : ∀ ω, 0 ≤ Z ω ∧ Z ω ≤ 1 := fun ω ↦ by
    rw [hZ]
    dsimp only
    split_ifs
    exacts [hu01 ω, hw01 ω, ⟨zero_le_one, le_rfl⟩]
  have hupos : ∀ᵐ ω ∂μ, 0 < u ω ∧ 0 < w ω := by
    filter_upwards [hboth] with ω h
    rw [hu, hw]
    dsimp only
    by_cases hs : a ω + b ω = 0
    · simp [hs]
    · have hs' : 0 < a ω + b ω := lt_of_le_of_ne (add_nonneg (ha0 ω) (hb0 ω)) (Ne.symm hs)
      have hab' : 0 < a ω ∧ 0 < b ω := by
        by_cases h1 : 0 < a ω
        · exact ⟨h1, h.1 h1⟩
        · by_cases h2 : 0 < b ω
          · exact ⟨h.2 h2, h2⟩
          · exact absurd (by linarith [ha0 ω, hb0 ω, not_lt.1 h1, not_lt.1 h2]) hs
      simp only [hs, ↓reduceIte]
      exact ⟨div_pos hab'.2 hs', div_pos hab'.1 hs'⟩
  have hZpos : ∀ᵐ ω ∂μ, 0 < Z ω := by
    filter_upwards [hupos] with ω ⟨h1, h2⟩
    rw [hZ]
    dsimp only
    split_ifs <;> first | exact h1 | exact h2 | exact one_pos
  refine ⟨Z, hZ_m, hZ01, hZpos, fun g hg ⟨K, hK⟩ ↦ ?_⟩
  have hZX (ω : Ω) : Z ω * X ω = u ω * max (X ω) 0 - w ω * max (-X ω) 0 := by
    rw [hZ]
    dsimp only
    rcases lt_trichotomy (X ω) 0 with h | h | h
    · simp only [not_lt.2 h.le, h, ↓reduceIte, max_eq_right h.le,
        max_eq_left (by linarith : 0 ≤ -X ω)]
      ring
    · simp [h]
    · simp only [h, ↓reduceIte, max_eq_left h.le, max_eq_right (by linarith : -X ω ≤ 0)]
      ring
  have hbd (v : Ω → ℝ) (hv : ∀ ω, 0 ≤ v ω ∧ v ω ≤ 1) (ω : Ω) : ‖g ω * v ω‖ ≤ K := by
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hv ω).1]
    exact (mul_le_of_le_one_right (abs_nonneg _) (hv ω).2).trans (hK ω)
  have hgu_m : StronglyMeasurable[m] (g * u) := hg.mul hu_m
  have hgw_m : StronglyMeasurable[m] (g * w) := hg.mul hw_m
  have hI1 : Integrable ((g * u) * fun ω ↦ max (X ω) 0) μ :=
    hXp.bdd_mul (hgu_m.mono hm0).aestronglyMeasurable (ae_of_all _ (hbd u hu01))
  have hI2 : Integrable ((g * w) * fun ω ↦ max (-X ω) 0) μ :=
    hXn.bdd_mul (hgw_m.mono hm0).aestronglyMeasurable (ae_of_all _ (hbd w hw01))
  have hpt (ω : Ω) : (g * u) ω * a ω = (g * w) ω * b ω := by
    by_cases hs : a ω + b ω = 0
    · have h1 : a ω = 0 := by linarith [ha0 ω, hb0 ω]
      have h2 : b ω = 0 := by linarith [ha0 ω, hb0 ω]
      simp [h1, h2]
    · show g ω * u ω * a ω = g ω * w ω * b ω
      rw [hu, hw]
      dsimp only
      simp only [hs, ↓reduceIte]
      field_simp
  calc ∫ ω, g ω * (Z ω * X ω) ∂μ
      = ∫ ω, ((g * u) ω * max (X ω) 0 - (g * w) ω * max (-X ω) 0) ∂μ :=
        integral_congr_ae (ae_of_all _ fun ω ↦ by simp only [hZX, Pi.mul_apply]; ring)
    _ = ∫ ω, (g * u) ω * max (X ω) 0 ∂μ - ∫ ω, (g * w) ω * max (-X ω) 0 ∂μ :=
        integral_sub hI1 hI2
    _ = ∫ ω, (g * u) ω * (μ[fun ω ↦ max (X ω) 0 | m]) ω ∂μ
          - ∫ ω, (g * w) ω * (μ[fun ω ↦ max (-X ω) 0 | m]) ω ∂μ := by
        rw [integral_mul_condExp hm0 hgu_m hI1 hXp, integral_mul_condExp hm0 hgw_m hI2 hXn]
    _ = ∫ ω, (g * u) ω * a ω ∂μ - ∫ ω, (g * w) ω * b ω ∂μ := by
        congr 1
        · exact integral_congr_ae (ha_ae.mono fun ω h ↦ by simp only [h])
        · exact integral_congr_ae (hb_ae.mono fun ω h ↦ by simp only [h])
    _ = 0 := sub_eq_zero.2 (integral_congr_ae (ae_of_all _ hpt))

end OnePeriod

section Backward

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {𝓕 : Filtration ℕ m0} {S : ℕ → Ω → ℝ}

/-- No arbitrage in a one-period market passes to an equivalent measure. -/
theorem NoArbitrageAt.of_absolutelyContinuous {μ ν : Measure Ω} {t : ℕ}
    (h : NoArbitrageAt 𝓕 μ S t) (hνμ : ν ≪ μ) (hμν : μ ≪ ν) : NoArbitrageAt 𝓕 ν S t :=
  fun θ hθ hpos ↦ hνμ.ae_eq (h θ hθ (hμν.ae_le hpos))

/-- **Backward induction on the horizon.** For a finite measure `P` under which the price is
integrable and every conditional one-period market is arbitrage free, and every `k ≤ N`, there is
a measure `ν ≤ P`, with `P ≪ ν`, under which the last `k` increments `S (s+1) - S s` are fair
against every bounded `𝓕 s`-measurable position. Each step weights `ν` by the density of
`exists_weight_of_noArbitrage` for the period before the last `k`. -/
theorem exists_measure_fair_increments {P : Measure Ω} [IsFiniteMeasure P] {N : ℕ}
    (hS : ∀ t ≤ N, StronglyMeasurable[𝓕 t] (S t)) (hint : ∀ t ≤ N, Integrable (S t) P)
    (hNA : NoArbitrageLocal 𝓕 P S N) (k : ℕ) (hk : k ≤ N) :
    ∃ ν : Measure Ω, ν ≤ P ∧ P ≪ ν ∧ ∀ s, N - k ≤ s → s < N → ∀ g : Ω → ℝ,
      StronglyMeasurable[𝓕 s] g → (∃ K, ∀ ω, |g ω| ≤ K) →
        ∫ ω, g ω * (S (s + 1) ω - S s ω) ∂ν = 0 := by
  induction k with
  | zero => exact ⟨P, le_rfl, Measure.AbsolutelyContinuous.rfl, fun s h1 h2 ↦ absurd h2 (by omega)⟩
  | succ k ih =>
    obtain ⟨ν, hνP, hPν, hν⟩ := ih (by omega)
    obtain ⟨t, ht⟩ : ∃ t, N = t + k + 1 := ⟨N - (k + 1), by omega⟩
    have : IsFiniteMeasure ν := isFiniteMeasure_of_le P hνP
    have hνac : ν ≪ P := Measure.absolutelyContinuous_of_le hνP
    have hXm : StronglyMeasurable[𝓕 (t + 1)] fun ω ↦ S (t + 1) ω - S t ω :=
      (hS (t + 1) (by omega)).sub ((hS t (by omega)).mono (𝓕.mono t.le_succ))
    have hXi : Integrable (fun ω ↦ S (t + 1) ω - S t ω) ν :=
      ((hint (t + 1) (by omega)).sub (hint t (by omega))).mono_measure hνP
    have hNAν := (hNA t (by omega)).of_absolutelyContinuous hνac hPν
    obtain ⟨Z, hZm, hZ01, hZpos, hZ⟩ := exists_weight_of_noArbitrage (𝓕.mono t.le_succ)
      (𝓕.le (t + 1)) hXm hXi fun θ hθ hpos ↦ by
        simpa [mul_comm] using hNAν θ hθ (by simpa [mul_comm] using hpos)
    have hZm0 : Measurable Z := hZm.measurable.mono (𝓕.le (t + 1)) le_rfl
    refine ⟨ν.withDensity fun ω ↦ ENNReal.ofReal (Z ω), ?_, ?_, fun s hs1 hs2 g hg hgb ↦ ?_⟩
    · exact (withDensity_mono (ae_of_all _ fun ω ↦ ENNReal.ofReal_le_one.2 (hZ01 ω).2)).trans
        (withDensity_one ▸ hνP)
    · exact hPν.trans (withDensity_absolutelyContinuous' hZm0.ennreal_ofReal.aemeasurable
        (hZpos.mono fun ω h ↦ (ENNReal.ofReal_pos.2 h).ne'))
    · rw [integral_withDensity_eq_integral_toReal_smul hZm0.ennreal_ofReal
        (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top)]
      simp only [smul_eq_mul, ENNReal.toReal_ofReal (hZ01 _).1]
      obtain ⟨K, hK⟩ := hgb
      rcases eq_or_lt_of_le (show t ≤ s by omega) with rfl | hst
      · rw [← hZ g hg ⟨K, hK⟩]
        congr 1
        funext ω
        ring
      · have := hν s (by omega) hs2 (Z * g) ((hZm.mono (𝓕.mono hst)).mul hg)
          ⟨K, fun ω ↦ by
            rw [Pi.mul_apply, abs_mul, abs_of_nonneg (hZ01 ω).1]
            exact (mul_le_of_le_one_left (abs_nonneg _) (hZ01 ω).2).trans (hK ω)⟩
        simpa [mul_assoc] using this

end Backward

section Main

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {𝓕 : Filtration ℕ m0} {S : ℕ → Ω → ℝ} {N : ℕ}
  {P : Measure Ω}

/-- **Integrability is a change of equivalent measure.** On a finite measure space, an adapted
price up to the horizon `N` is integrable under the equivalent finite measure with density
`exp (-∑ₙ ‖S n‖)`, which is positive and at most `1`: `‖S n‖ exp (-‖S n‖) ≤ 1`. -/
theorem exists_integrable_equivalent [IsFiniteMeasure P]
    (hS : ∀ t ≤ N, StronglyMeasurable[𝓕 t] (S t)) :
    ∃ P' : Measure Ω, P' ≤ P ∧ P ≪ P' ∧ ∀ t ≤ N, Integrable (S t) P' := by
  have hm (n : ℕ) (hn : n ≤ N) : Measurable (S n) := (hS n hn).measurable.mono (𝓕.le n) le_rfl
  obtain ⟨w, hw⟩ : ∃ w : Ω → ℝ, w = fun ω ↦ Real.exp (-∑ n ∈ Finset.range (N + 1), ‖S n ω‖) :=
    ⟨_, rfl⟩
  have hwm : Measurable w := hw ▸ (Finset.measurable_sum _ fun n hn ↦
    (hm n (Nat.lt_succ_iff.1 (Finset.mem_range.1 hn))).norm).neg.exp
  have hw0 (ω : Ω) : 0 < w ω := hw ▸ Real.exp_pos _
  have hw1 (ω : Ω) : w ω ≤ 1 := by
    rw [hw]
    exact Real.exp_le_one_iff.2 (neg_nonpos.2 (Finset.sum_nonneg fun n _ ↦ norm_nonneg _))
  refine ⟨P.withDensity fun ω ↦ ENNReal.ofReal (w ω), ?_, ?_, fun t ht ↦ ?_⟩
  · exact (withDensity_mono (ae_of_all _ fun ω ↦ ENNReal.ofReal_le_one.2 (hw1 ω))).trans
      (withDensity_one ▸ le_rfl)
  · exact withDensity_absolutelyContinuous' hwm.ennreal_ofReal.aemeasurable
      (ae_of_all _ fun ω ↦ (ENNReal.ofReal_pos.2 (hw0 ω)).ne')
  · rw [integrable_withDensity_iff_integrable_smul' hwm.ennreal_ofReal
      (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top)]
    refine Integrable.mono' (integrable_const 1)
      ((hwm.ennreal_ofReal.ennreal_toReal.smul (hm t ht)).aestronglyMeasurable)
      (ae_of_all _ fun ω ↦ ?_)
    have hle : ‖S t ω‖ ≤ ∑ n ∈ Finset.range (N + 1), ‖S n ω‖ :=
      Finset.single_le_sum (f := fun n ↦ ‖S n ω‖) (fun n _ ↦ norm_nonneg _)
        (Finset.mem_range.2 (Nat.lt_succ_of_le ht))
    rw [ENNReal.toReal_ofReal (hw0 ω).le, smul_eq_mul, norm_mul, Real.norm_of_nonneg (hw0 ω).le]
    calc w ω * ‖S t ω‖ ≤ Real.exp (-‖S t ω‖) * ‖S t ω‖ := by
          gcongr
          rw [hw]
          exact Real.exp_le_exp.2 (neg_le_neg hle)
      _ ≤ 1 := by
          rw [Real.exp_neg, inv_mul_le_iff₀ (Real.exp_pos _), mul_one]
          exact (Real.add_one_le_exp _).trans' (by linarith)

namespace OneAsset

/-- **Dalang–Morton–Willinger for one asset on a general probability space.** For an adapted
real price `S` on a filtered probability space (no integrability, no finiteness of the space, no
measurable-selection hypothesis), no arbitrage up to the horizon `N` gives an equivalent martingale
measure.

The measure is built by backward induction on the horizon. First `P` is replaced by an equivalent
measure making `S` integrable (`exists_integrable_equivalent`). Then each conditional one-period
market contributes an `𝓕 (t+1)`-measurable weight `Z t ∈ (0, 1]` balancing the increment
(`exists_weight_of_noArbitrage`), applied under the measure already weighted by the later periods
(`exists_measure_fair_increments`). The weights are not normalised period by period (a conditional
one-period density can be unbounded, and the one-period theorem of `DalangMortonWillinger.lean`
can fail for this reason); only the total mass is normalised, at the end. -/
theorem exists_isEMM_of_noArbitrage [IsProbabilityMeasure P]
    (hS : ∀ t ≤ N, StronglyMeasurable[𝓕 t] (S t)) (hNA : NoArbitrage 𝓕 P S N) :
    ∃ Q, IsEMM 𝓕 P S N Q := by
  obtain ⟨P', hP'P, hPP', hint⟩ := exists_integrable_equivalent (P := P) hS
  have : IsFiniteMeasure P' := isFiniteMeasure_of_le P hP'P
  obtain ⟨ν, hνP', hP'ν, hν⟩ := exists_measure_fair_increments hS hint
    (fun t ht ↦ (noArbitrageLocal_of_noArbitrage hNA t ht).of_absolutelyContinuous
      (Measure.absolutelyContinuous_of_le hP'P) hPP') N le_rfl
  have : IsFiniteMeasure ν := isFiniteMeasure_of_le P' hνP'
  have hν0 : ν Set.univ ≠ 0 := fun h ↦ by simpa using (hPP'.trans hP'ν) h
  have hc0 : (ν Set.univ)⁻¹ ≠ 0 := ENNReal.inv_ne_zero.2 (measure_ne_top _ _)
  have hcT : (ν Set.univ)⁻¹ ≠ ∞ := ENNReal.inv_ne_top.2 hν0
  set Q : Measure Ω := (ν Set.univ)⁻¹ • ν
  have hQprob : IsProbabilityMeasure Q :=
    ⟨by simp [Q, ENNReal.inv_mul_cancel hν0 (measure_ne_top _ _)]⟩
  have hQν : Q ≪ ν := fun A hA ↦ by simp [Q, hA]
  have hνQ : ν ≪ Q := Measure.absolutelyContinuous_smul hc0
  have hνP : ν ≪ P := Measure.absolutelyContinuous_of_le (hνP'.trans hP'P)
  have hQint (t : ℕ) (ht : t ≤ N) : Integrable (S t) Q :=
    ((hint t ht).mono_measure hνP').smul_measure hcT
  have hfair (t : ℕ) (ht : t < N) (A : Set Ω) (hA : MeasurableSet[𝓕 t] A) :
      ∫ x in A, S t x ∂ν = ∫ x in A, S (t + 1) x ∂ν := by
    have h1 := hν t (by omega) ht (A.indicator fun _ ↦ 1) (stronglyMeasurable_const.indicator hA)
      ⟨1, fun ω ↦ by by_cases h : ω ∈ A <;> simp [h]⟩
    have h2 : (fun ω ↦ A.indicator (fun _ ↦ (1 : ℝ)) ω * (S (t + 1) ω - S t ω)) =
        A.indicator fun ω ↦ S (t + 1) ω - S t ω := by
      funext ω
      by_cases h : ω ∈ A <;> simp [h]
    rw [h2, integral_indicator (𝓕.le t A hA), integral_sub
      ((hint (t + 1) ht).mono_measure hνP').integrableOn
      ((hint t ht.le).mono_measure hνP').integrableOn] at h1
    linarith
  exact ⟨Q, IsEMM.of_condExp_succ ⟨hQprob, hQν.trans hνP, hPP'.trans (hP'ν.trans hνQ)⟩ hS hQint
    fun t ht ↦ ae_eq_condExp_of_forall_setIntegral_eq (𝓕.le t) (hQint (t + 1) ht)
      (fun A _ _ ↦ (hQint t ht.le).integrableOn)
      (fun A hA _ ↦ by simp only [Q, Measure.restrict_smul, integral_smul_measure, hfair t ht A hA])
      (hS t ht.le).aestronglyMeasurable⟩

/-- **The fundamental theorem of asset pricing for one asset on a general probability space**
(Dalang–Morton–Willinger, `d = 1`): an adapted real price has no arbitrage up to the horizon if and
only if it has an equivalent martingale measure. The converse is `IsEMM.noArbitrage`. -/
theorem noArbitrage_iff_exists_isEMM [IsProbabilityMeasure P]
    (hS : ∀ t ≤ N, StronglyMeasurable[𝓕 t] (S t)) :
    NoArbitrage 𝓕 P S N ↔ ∃ Q, IsEMM 𝓕 P S N Q :=
  ⟨exists_isEMM_of_noArbitrage hS, fun ⟨_, hQ⟩ ↦ hQ.noArbitrage⟩

end OneAsset

