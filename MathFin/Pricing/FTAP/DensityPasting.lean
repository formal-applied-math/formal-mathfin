module

public import MathFin.Pricing.EquivMartingaleMeasure
public import MathFin.Probability.Martingales.EquivMeasure
public import MathFin.Pricing.FTAP.FTAP

/-!
# Pasting one-period densities into an equivalent martingale measure

The pasting step of the Dalang–Morton–Willinger theorem, as one backward construction. Let `S` be
an adapted `F`-valued discounted price on a filtered probability space `(Ω, 𝓕, P)` with finite
horizon `N`. A *one-period density* for period `t` under a measure `ν` is an `𝓕 (t+1)`-measurable
weight `Z` with values in `[0, 1]`, almost surely positive, that makes the increment fair against
every bounded `𝓕 t`-measurable position, `∫ g • (Z • (S (t+1) − S t)) dν = 0`
(`IsOnePeriodDensity`). It is **not normalised**: `E[Z | 𝓕 t] = 1` is not asked, because a
conditional one-period density of mean one can fail to exist for an arbitrage-free market (take
`𝓕 t` generated by a uniform `u` and `ΔS = ±1` with `P (ΔS = 1 | u) = u`: mean one forces
`Z = 1 / (2u)` on `{ΔS = 1}`, which is unbounded), while the weights in `[0, 1]` always do.

Given such a weight for each period, under every finite measure already weighted by the later
periods, the weights are applied backward from the horizon (`exists_measure_fair_increments`):
the measure `ν` obtained is below `P`, equivalent to it, and makes every increment fair against
every bounded predictable position, because a weight `Z t` that is `𝓕 (t+1)`-measurable and
bounded folds into the position of any later period. Only then is the total mass normalised, once
(`exists_isEMM_of_fair_measure`), which turns `ν` into an equivalent martingale measure
(`exists_isEMM_of_onePeriodDensities`).

That conditional one-period no arbitrage *produces* such densities is the remaining step of the
Dalang–Morton–Willinger theorem. For one real asset it is proved in `OneAssetDMW.lean`; for
`d > 1` assets it is the hypothesis of `DalangMortonWillinger.lean`.

## Main definitions

* `IsOnePeriodDensity`: an `𝓕 (t+1)`-measurable weight in `[0, 1]`, almost surely positive, under
  which `S (t+1) − S t` is fair against every bounded `𝓕 t`-measurable position.

## Main results

* `exists_measure_fair_increments`: backward induction on the horizon.
* `exists_isEMM_of_fair_measure`: normalising once, a measure making all increments fair is an
  equivalent martingale measure.
* `exists_isEMM_of_onePeriodDensities`: one-period densities in every period, under every
  intermediate measure, give an equivalent martingale measure.

## References

* [H. Föllmer and A. Schied, *Stochastic Finance: An Introduction in Discrete Time*][FollmerSchied],
  §5.2

## Tags

equivalent martingale measure, change of measure, backward induction, pasting of one-period
measures, Dalang–Morton–Willinger, JEL G13, MSC 91G20, MSC 60G42, MSC 60G44
-/

@[expose] public section

namespace MathFin

open MeasureTheory
open scoped ENNReal

variable {Ω : Type*} {m0 : MeasurableSpace Ω}
  {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
  {𝓕 : Filtration ℕ m0} {S : ℕ → Ω → F}

/-- **A one-period density for period `t` under `ν`**: an `𝓕 (t+1)`-measurable weight `Z` valued
in `[0, 1]`, `ν`-almost surely positive, against which the increment `S (t+1) − S t` is fair for
every bounded `𝓕 t`-measurable position `g`: `∫ g • (Z • (S (t+1) − S t)) dν = 0`. It is a
one-period equivalent martingale measure conditional on `𝓕 t`, up to normalisation, which is not
asked (see the module docstring). -/
structure IsOnePeriodDensity (𝓕 : Filtration ℕ m0) (ν : Measure Ω) (S : ℕ → Ω → F) (t : ℕ)
    (Z : Ω → ℝ) : Prop where
  meas : StronglyMeasurable[𝓕 (t + 1)] Z
  mem_Icc : ∀ ω, Z ω ∈ Set.Icc (0 : ℝ) 1
  pos : ∀ᵐ ω ∂ν, 0 < Z ω
  fair : ∀ g : Ω → ℝ, StronglyMeasurable[𝓕 t] g → (∃ K, ∀ ω, |g ω| ≤ K) →
    ∫ ω, g ω • (Z ω • (S (t + 1) ω - S t ω)) ∂ν = 0

omit [CompleteSpace F] in
/-- **Backward induction on the horizon.** Let `P` be a finite measure and suppose that for every
period `t < N` and every finite measure `ν ≤ P` with `P ≪ ν` there is a one-period density for
`t` under `ν`. Then for every `k ≤ N` there is a measure `ν ≤ P`, with `P ≪ ν`, under which the
last `k` increments `S (s+1) − S s` are fair against every bounded `𝓕 s`-measurable position. Each
step weights `ν` by the density of the period before the last `k`. -/
theorem exists_measure_fair_increments {P : Measure Ω} [IsFiniteMeasure P] {N : ℕ}
    (hZ : ∀ t < N, ∀ ν : Measure Ω, IsFiniteMeasure ν → ν ≤ P → P ≪ ν →
      ∃ Z, IsOnePeriodDensity 𝓕 ν S t Z) (k : ℕ) (hk : k ≤ N) :
    ∃ ν : Measure Ω, ν ≤ P ∧ P ≪ ν ∧ ∀ s, N - k ≤ s → s < N → ∀ g : Ω → ℝ,
      StronglyMeasurable[𝓕 s] g → (∃ K, ∀ ω, |g ω| ≤ K) →
        ∫ ω, g ω • (S (s + 1) ω - S s ω) ∂ν = 0 := by
  induction k with
  | zero => exact ⟨P, le_rfl, Measure.AbsolutelyContinuous.rfl, fun s h1 h2 ↦ absurd h2 (by omega)⟩
  | succ k ih =>
    obtain ⟨ν, hνP, hPν, hν⟩ := ih (by omega)
    obtain ⟨t, ht⟩ : ∃ t, N = t + k + 1 := ⟨N - (k + 1), by omega⟩
    have : IsFiniteMeasure ν := isFiniteMeasure_of_le P hνP
    obtain ⟨Z, hZm, hZ01, hZpos, hZfair⟩ := hZ t (by omega) ν inferInstance hνP hPν
    have hZm0 : Measurable Z := hZm.measurable.mono (𝓕.le (t + 1)) le_rfl
    refine ⟨ν.withDensity fun ω ↦ ENNReal.ofReal (Z ω), ?_, ?_, fun s hs1 hs2 g hg hgb ↦ ?_⟩
    · exact (withDensity_mono (ae_of_all _ fun ω ↦ ENNReal.ofReal_le_one.2 (hZ01 ω).2)).trans
        (withDensity_one ▸ hνP)
    · exact hPν.trans (withDensity_absolutelyContinuous' hZm0.ennreal_ofReal.aemeasurable
        (hZpos.mono fun ω h ↦ (ENNReal.ofReal_pos.2 h).ne'))
    · rw [integral_withDensity_eq_integral_toReal_smul hZm0.ennreal_ofReal
        (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top)]
      simp only [ENNReal.toReal_ofReal (hZ01 _).1]
      obtain ⟨K, hK⟩ := hgb
      rcases eq_or_lt_of_le (show t ≤ s by omega) with rfl | hst
      · exact (integral_congr_ae (ae_of_all _ fun ω ↦ smul_comm _ _ _)).trans
          (hZfair g hg ⟨K, hK⟩)
      · simpa [mul_smul] using hν s (by omega) hs2 (Z * g) ((hZm.mono (𝓕.mono hst)).mul hg)
          ⟨K, fun ω ↦ by
            rw [Pi.mul_apply, abs_mul, abs_of_nonneg (hZ01 ω).1]
            exact (mul_le_of_le_one_left (abs_nonneg _) (hZ01 ω).2).trans (hK ω)⟩

variable {P : Measure Ω} {N : ℕ}

/-- **Normalising once, at the end.** If a finite measure `ν`, equivalent to the probability
measure `P`, makes `S` integrable and every increment `S (s+1) − S s`, `s < N`, fair against every
bounded `𝓕 s`-measurable position, then `ν` normalised to total mass one is an equivalent martingale
measure for `S` up to the horizon `N`. -/
theorem exists_isEMM_of_fair_measure [IsProbabilityMeasure P] {ν : Measure Ω} [IsFiniteMeasure ν]
    (hνP : ν ≪ P) (hPν : P ≪ ν) (hS : ∀ t ≤ N, StronglyMeasurable[𝓕 t] (S t))
    (hint : ∀ t ≤ N, Integrable (S t) ν)
    (hfair : ∀ s < N, ∀ g : Ω → ℝ, StronglyMeasurable[𝓕 s] g → (∃ K, ∀ ω, |g ω| ≤ K) →
      ∫ ω, g ω • (S (s + 1) ω - S s ω) ∂ν = 0) :
    ∃ Q, IsEMM 𝓕 P S N Q := by
  have hν0 : ν Set.univ ≠ 0 := fun h ↦ by simpa using hPν h
  have hc0 : (ν Set.univ)⁻¹ ≠ 0 := ENNReal.inv_ne_zero.2 (measure_ne_top _ _)
  have hcT : (ν Set.univ)⁻¹ ≠ ∞ := ENNReal.inv_ne_top.2 hν0
  set Q : Measure Ω := (ν Set.univ)⁻¹ • ν
  have hQprob : IsProbabilityMeasure Q :=
    ⟨by simp [Q, ENNReal.inv_mul_cancel hν0 (measure_ne_top _ _)]⟩
  have hQν : Q ≪ ν := fun A hA ↦ by simp [Q, hA]
  have hνQ : ν ≪ Q := Measure.absolutelyContinuous_smul hc0
  have hQint (t : ℕ) (ht : t ≤ N) : Integrable (S t) Q := (hint t ht).smul_measure hcT
  have hfair' (t : ℕ) (ht : t < N) (A : Set Ω) (hA : MeasurableSet[𝓕 t] A) :
      ∫ x in A, S t x ∂ν = ∫ x in A, S (t + 1) x ∂ν := by
    have h1 := hfair t ht (A.indicator fun _ ↦ 1) (stronglyMeasurable_const.indicator hA)
      ⟨1, fun ω ↦ by by_cases h : ω ∈ A <;> simp [h]⟩
    have h2 : (fun ω ↦ A.indicator (fun _ ↦ (1 : ℝ)) ω • (S (t + 1) ω - S t ω)) =
        A.indicator fun ω ↦ S (t + 1) ω - S t ω := by
      funext ω
      by_cases h : ω ∈ A <;> simp [h]
    rw [h2, integral_indicator (𝓕.le t A hA), integral_sub (hint (t + 1) ht).integrableOn
      (hint t ht.le).integrableOn] at h1
    exact (sub_eq_zero.1 h1).symm
  exact ⟨Q, IsEMM.of_condExp_succ ⟨hQprob, hQν.trans hνP, hPν.trans hνQ⟩ hS hQint
    fun t ht ↦ ae_eq_condExp_of_forall_setIntegral_eq (𝓕.le t) (hQint (t + 1) ht)
      (fun A _ _ ↦ (hQint t ht.le).integrableOn)
      (fun A hA _ ↦ by
        simp only [Q, Measure.restrict_smul, integral_smul_measure, hfair' t ht A hA])
      (hS t ht.le).aestronglyMeasurable⟩

/-- **One-period densities paste to an equivalent martingale measure.** For an adapted integrable
price `S` on a filtered probability space, if for every period `t < N` and every finite measure
`ν ≤ P`, equivalent to `P`, there is a one-period density for `t` under `ν`
(`IsOnePeriodDensity`), then `S` has an equivalent martingale measure up to the horizon `N`.
The measure is built by backward induction (`exists_measure_fair_increments`) and normalised once
(`exists_isEMM_of_fair_measure`). -/
theorem exists_isEMM_of_onePeriodDensities [IsProbabilityMeasure P]
    (hS : ∀ t ≤ N, StronglyMeasurable[𝓕 t] (S t)) (hint : ∀ t ≤ N, Integrable (S t) P)
    (hZ : ∀ t < N, ∀ ν : Measure Ω, IsFiniteMeasure ν → ν ≤ P → P ≪ ν →
      ∃ Z, IsOnePeriodDensity 𝓕 ν S t Z) :
    ∃ Q, IsEMM 𝓕 P S N Q := by
  obtain ⟨ν, hνP, hPν, hν⟩ := exists_measure_fair_increments hZ N le_rfl
  have : IsFiniteMeasure ν := isFiniteMeasure_of_le P hνP
  exact exists_isEMM_of_fair_measure (Measure.absolutelyContinuous_of_le hνP) hPν hS
    (fun t ht ↦ (hint t ht).mono_measure hνP) fun s hs ↦ hν s (by omega) hs

end MathFin
