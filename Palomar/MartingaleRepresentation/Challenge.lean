module

public import Mathlib.Probability.BrownianMotion.Basic
public import Mathlib.Probability.Process.Predictable

/-!
# The martingale representation theorem for Brownian motion

`B` is a real process on a probability space `(Ω, μ)` with the finite-dimensional laws of a
Brownian motion (Mathlib's `IsPreBrownianReal`), measurable coordinates and continuous paths, and
`𝓕ᴮ` is its natural filtration (`brownianFiltration`). An integrand up to the horizon `T` is an
element of `L²(integrandMeasure)`: a class of functions on `ℝ≥0 × Ω`, measurable for the
predictable σ-algebra of `𝓕ᴮ`, square-integrable for Lebesgue measure on `(0, T]` times `μ`.

The Itô integral is not built here: it is *characterized*. `IsItoIntegral I` says that the
continuous linear map `I` from integrands to `L²(μ)` sends the indicator of every predictable
rectangle `(s, t] × F`, `s ≤ t ≤ T`, `F ∈ 𝓕ᴮ_s`, to `𝟙_F (B_t − B_s)`. Three theorems follow.

* `existsUnique_isItoIntegral`: exactly one such map exists. Existence says the rectangle values
  extend continuously; uniqueness says the rectangles span a dense subspace, so `IsItoIntegral`
  pins the map down and the theorems below are about the Itô integral, not about a family of
  candidates.
* `norm_apply_of_isItoIntegral`: the Itô isometry, `‖∫₀ᵀ φ dB‖_{L²(μ)} = ‖φ‖`.
* `existsUnique_itoIntegral_representation`: the martingale representation theorem in terminal
  form (Itô, *J. Math. Soc. Japan* 3 (1951); see Karatzas and Shreve, *Brownian Motion and
  Stochastic Calculus*, §3.4). Every square-integrable `𝓕ᴮ_T`-measurable `H` is its mean plus an
  Itô integral, `H = 𝔼[H] + ∫₀ᵀ φ dB` almost surely, for a unique integrand `φ`.

Scope, stated here so the reader need not reconstruct it:

* one-dimensional Brownian motion, finite horizon `T`, and the *natural* filtration of `B`;
  `H` is only asked to be almost everywhere equal to an `𝓕ᴮ_T`-measurable function, so null
  events cost nothing;
* the representation is the terminal one, of a single random variable; the process form
  (a square-integrable `𝓕ᴮ`-martingale is its initial value plus an Itô integral process) and
  the local-martingale form are not claimed here;
* the integrand's uniqueness is uniqueness in `L²(integrandMeasure)`, that is, up to a
  `dt ⊗ dμ`-null predictable set.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace BrownianRepresentation

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-- The predictable σ-algebra of a filtration indexed by `ℝ≥0` is coarser than the product
σ-algebra on `ℝ≥0 × Ω`, so a measure on the product restricts (`Measure.trim`) to it. -/
theorem predictable_le_prod (𝓕 : Filtration ℝ≥0 mΩ) :
    𝓕.predictable ≤ Prod.instMeasurableSpace := by
  unfold Filtration.predictable
  apply MeasurableSpace.generateFrom_le
  rintro s (⟨A, hA, rfl⟩ | ⟨i, A, hA, rfl⟩)
  · exact (measurableSet_singleton _).prod (𝓕.le _ _ hA)
  · exact measurableSet_Ioi.prod (𝓕.le _ _ hA)

/-- The **natural filtration** of `B`: `𝓕ᴮ_t` is generated by the `B_s`, `s ≤ t`. -/
noncomputable def brownianFiltration (B : ℝ≥0 → Ω → ℝ) (hB : ∀ t, Measurable (B t)) :
    Filtration ℝ≥0 mΩ :=
  Filtration.natural B fun t ↦ (hB t).stronglyMeasurable

/-- The **integrand measure** up to the horizon `T`: Lebesgue measure on `(0, T]` times `μ`,
restricted to the predictable σ-algebra of `𝓕ᴮ`. Its `L²` space is the space of predictable
integrands `φ` with `𝔼 ∫₀ᵀ φ_t² dt < ∞`. -/
noncomputable def integrandMeasure (μ : Measure Ω) (B : ℝ≥0 → Ω → ℝ)
    (hB : ∀ t, Measurable (B t)) (T : ℝ≥0) :=
  (((Measure.comap ((↑) : ℝ≥0 → ℝ) volume).restrict (Set.Ioc 0 T)).prod μ).trim
    (predictable_le_prod (brownianFiltration B hB))

/-- `I` is **an Itô integral up to the horizon `T`**: a continuous linear map from integrands to
`L²(μ)` that sends the indicator of each predictable rectangle `(s, t] × F`, with `s ≤ t ≤ T` and
`F ∈ 𝓕ᴮ_s`, to `𝟙_F (B_t − B_s)`. -/
def IsItoIntegral (μ : Measure Ω) (B : ℝ≥0 → Ω → ℝ) (hB : ∀ t, Measurable (B t)) (T : ℝ≥0)
    (I : Lp ℝ 2 (integrandMeasure μ B hB T) →L[ℝ] Lp ℝ 2 μ) : Prop :=
  ∀ s t : ℝ≥0, s ≤ t → t ≤ T → ∀ F : Set Ω, MeasurableSet[brownianFiltration B hB s] F →
    ∀ φ : Lp ℝ 2 (integrandMeasure μ B hB T),
      ⇑φ =ᵐ[integrandMeasure μ B hB T] (Set.Ioc s t ×ˢ F).indicator (fun _ ↦ (1 : ℝ)) →
        ⇑(I φ) =ᵐ[μ] F.indicator fun ω ↦ B t ω - B s ω

variable {μ : Measure Ω} {B : ℝ≥0 → Ω → ℝ}

/-- **The Itô integral exists and is unique.** For a pre-Brownian motion with measurable
coordinates, exactly one continuous linear map is an Itô integral up to `T`. -/
theorem existsUnique_isItoIntegral (hB : IsPreBrownianReal B μ) (hBmeas : ∀ t, Measurable (B t))
    (T : ℝ≥0) : ∃! I, IsItoIntegral μ B hBmeas T I := by
  sorry

/-- **The Itô isometry**: `‖∫₀ᵀ φ dB‖_{L²(μ)} = ‖φ‖_{L²(integrandMeasure)}`. -/
theorem norm_apply_of_isItoIntegral (hB : IsPreBrownianReal B μ)
    (hBmeas : ∀ t, Measurable (B t)) {T : ℝ≥0}
    {I : Lp ℝ 2 (integrandMeasure μ B hBmeas T) →L[ℝ] Lp ℝ 2 μ}
    (hI : IsItoIntegral μ B hBmeas T I) (φ : Lp ℝ 2 (integrandMeasure μ B hBmeas T)) :
    ‖I φ‖ = ‖φ‖ := by
  sorry

/-- **The martingale representation theorem**, terminal form. For a Brownian motion `B` (a
pre-Brownian motion with measurable coordinates and continuous paths), every square-integrable
`H` that is `𝓕ᴮ_T`-measurable up to a null set is its mean plus an Itô integral,
`H = 𝔼[H] + ∫₀ᵀ φ dB` almost surely, for a unique integrand `φ`. -/
theorem existsUnique_itoIntegral_representation (hB : IsPreBrownianReal B μ)
    (hBmeas : ∀ t, Measurable (B t)) (hBcont : ∀ ω, Continuous fun t : ℝ≥0 ↦ B t ω) {T : ℝ≥0}
    {I : Lp ℝ 2 (integrandMeasure μ B hBmeas T) →L[ℝ] Lp ℝ 2 μ}
    (hI : IsItoIntegral μ B hBmeas T I) (H : Lp ℝ 2 μ)
    (hH : AEStronglyMeasurable[brownianFiltration B hBmeas T] H μ) :
    ∃! φ, ⇑H =ᵐ[μ] fun ω ↦ (∫ ω', H ω' ∂μ) + I φ ω := by
  sorry

end BrownianRepresentation
