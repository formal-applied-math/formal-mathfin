%% mathfin-paper.sty -- shared house style for the formal-mathfin papers.
%% pdfLaTeX only (arXiv compiles with pdfLaTeX). Palatino text and math,
%% small-caps headings, Lean listings with Unicode mapped to math glyphs.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathfin-paper}[2026/10/09 formal-mathfin paper style]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[sc]{mathpazo}
\RequirePackage[scaled=0.93]{newtxtt}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage[a4paper,margin=1.15in,headheight=14pt]{geometry}
\RequirePackage[protrusion=true,expansion=true]{microtype}
\RequirePackage{xcolor}
\RequirePackage{booktabs,tabularx,array}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{listings}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds}
\RequirePackage[hyphens]{url}
\RequirePackage[hidelinks,pdfusetitle,bookmarksnumbered]{hyperref}
\RequirePackage[nameinlink,capitalise,noabbrev]{cleveref}

\linespread{1.04}
\setlength{\parindent}{1.4em}
\frenchspacing
\setlist{itemsep=2pt,topsep=4pt,leftmargin=1.6em}
\emergencystretch=2.5em
\tolerance=800

%% ---------- colours ----------
\definecolor{mfaccent}{HTML}{7A5C2E}   % warm brown: rules, captions, figure strokes
\definecolor{mflink}{HTML}{1F4E79}
\definecolor{mfbg}{HTML}{F7F4EC}
\definecolor{mfrule}{HTML}{CFC5AE}
\definecolor{mfkw}{HTML}{2B4C7E}
\definecolor{mfcomment}{HTML}{7D7466}
\definecolor{mfmuted}{HTML}{6B6457}
\hypersetup{colorlinks=true,linkcolor=mflink,citecolor=mflink,urlcolor=mflink}

%% ---------- headings ----------
\titleformat{\section}{\normalfont\large\scshape}{\thesection}{0.8em}{}
\titleformat{\subsection}{\normalfont\normalsize\scshape}{\thesubsection}{0.8em}{}
\titleformat{\paragraph}[runin]{\normalfont\normalsize\bfseries}{}{0pt}{}[.]
\titlespacing*{\section}{0pt}{2.0ex plus .6ex minus .2ex}{1.0ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.6ex plus .5ex minus .2ex}{0.8ex plus .2ex}
\titlespacing*{\paragraph}{0pt}{1.0ex plus .4ex minus .2ex}{0.6em}

%% ---------- Lean identifiers in running text ----------
%% \lean{name} typesets a Lean identifier in typewriter and allows line breaks
%% after `_' and `.', so long names never run into the margin.
\DeclareUrlCommand\lean{\def\UrlFont{\ttfamily}%
  \def\UrlBreaks{\do\_\do\.\do\/}\def\UrlBigBreaks{}\def\UrlNoBreaks{}}
\DeclareUrlCommand\file{\def\UrlFont{\ttfamily}%
  \def\UrlBreaks{\do\_\do\.\do\/}\def\UrlBigBreaks{}\def\UrlNoBreaks{}}
%% \bench{id} typesets a benchmark-entry id, breakable after `-' and `.'.
\DeclareUrlCommand\bench{\def\UrlFont{\ttfamily}%
  \def\UrlBreaks{\do\-\do\.}\def\UrlBigBreaks{}\def\UrlNoBreaks{}}

%% ---------- theorem-like environments ----------
\newtheoremstyle{mfthm}{0.9ex}{0.9ex}{\itshape}{}{\scshape}{.}{0.5em}%
  {\thmname{#1}\thmnumber{ #2}\thmnote{ \normalfont(#3)}}
\newtheoremstyle{mfrem}{0.9ex}{0.9ex}{\normalfont}{}{\scshape}{.}{0.5em}%
  {\thmname{#1}\thmnumber{ #2}\thmnote{ \normalfont(#3)}}
\theoremstyle{mfthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\theoremstyle{mfrem}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{remark}[theorem]{Remark}
\newtheorem{example}[theorem]{Example}
\crefname{listing}{Listing}{Listings}

%% ---------- captions ----------
\captionsetup{font=small,labelfont={sc},labelsep=period,skip=4pt}
\captionsetup[lstlisting]{font={small,it},labelfont={small,it},labelsep=period,
  singlelinecheck=false,justification=raggedright,skip=3pt}
\renewcommand{\lstlistingname}{Listing}

%% ---------- Lean listings ----------
\lstdefinelanguage{lean}{%
  morekeywords={theorem,lemma,def,noncomputable,structure,class,instance,abbrev,
    where,fun,by,with,let,have,show,from,at,if,then,else,match,open,namespace,
    section,end,variable,extends,Prop,Type,Sort,calc,exact,refine,obtain,intro,
    private,protected,local,scoped},
  sensitive=true,
  morecomment=[l]{--},
  morecomment=[s]{/-}{-/},
  morestring=[b]",
}
