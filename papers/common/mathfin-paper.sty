%% ---------- misc ----------
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\E}{\mathbb{E}}
\newcommand{\Prob}{\mathbb{P}}
\newcommand{\ind}{\mathbf{1}}
\newcommand{\F}{\mathcal{F}}
\newcommand{\dd}{\mathrm{d}}
\newcommand{\ip}[2]{\langle #1,\,#2\rangle}
\newcommand{\norm}[1]{\lVert #1\rVert}
\newcommand{\abs}[1]{\lvert #1\rvert}
\newcommand{\ito}{\mathcal{I}}
\newcommand{\status}[1]{\texttt{#1}}

%% Non-breaking Lean listing: an lstlisting inside a full-width minipage, so a
%% short listing never splits across pages. Use \begin{leancode}[caption=...,label=...].
\newcommand\mf@leancodebegin{\par\addvspace{0.6ex}\noindent\minipage{\linewidth}}
\newcommand\mf@leancodeend{\endminipage\par\addvspace{0.9ex}}
\lstnewenvironment{leancode}[1][]
  {\mf@leancodebegin\lstset{#1}}
  {\mf@leancodeend}

\endinput
